// MMIX big-endian octa 4개와 AXI 라인(byte lane 0 = 가장 낮은 주소)을 서로 바꾼다. 양방향 같은 배선이다.
// octa j는 라인 [64j..64j+64)이고, 그 octa의 최상위 바이트가 가장 낮은 주소에 온다.
comb LineSwap {
    pub in: In<bit,256>
    pub out: Out<bit,256>
}
wire LineSwap {
    out[0..8] <- in[56..64]
    out[8..16] <- in[48..56]
    out[16..24] <- in[40..48]
    out[24..32] <- in[32..40]
    out[32..40] <- in[24..32]
    out[40..48] <- in[16..24]
    out[48..56] <- in[8..16]
    out[56..64] <- in[0..8]
    out[64..72] <- in[120..128]
    out[72..80] <- in[112..120]
    out[80..88] <- in[104..112]
    out[88..96] <- in[96..104]
    out[96..104] <- in[88..96]
    out[104..112] <- in[80..88]
    out[112..120] <- in[72..80]
    out[120..128] <- in[64..72]
    out[128..136] <- in[184..192]
    out[136..144] <- in[176..184]
    out[144..152] <- in[168..176]
    out[152..160] <- in[160..168]
    out[160..168] <- in[152..160]
    out[168..176] <- in[144..152]
    out[176..184] <- in[136..144]
    out[184..192] <- in[128..136]
    out[192..200] <- in[248..256]
    out[200..208] <- in[240..248]
    out[208..216] <- in[232..240]
    out[216..224] <- in[224..232]
    out[224..232] <- in[216..224]
    out[232..240] <- in[208..216]
    out[240..248] <- in[200..208]
    out[248..256] <- in[192..200]
}
