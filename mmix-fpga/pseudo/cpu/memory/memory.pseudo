bundle MemoryIO { // MemoryAccess 입장, 요청/응답 각 한 건씩
    req_valid: In<bit,1>
    req_ready: Out<bit,1>
    address: WordIn
    store: In<bit,1>
    size: In<bit,2>  // log2(bytes): 0/1/2/3
    zero_extend: In<bit,1>
    write_data: WordIn
    // 레지스터 스택 spill/fill: 32바이트 라인 하나 안의 octa 여러 개를 한 번에 옮긴다.
    // octa j는 라인 [64j..64j+64)이고 MMIX 값 그대로다. 쓰기는 line_mask의 octa만 바꾼다.
    line: In<bit,1>
    line_mask: In<bit,4>
    line_write_data: In<bit,256>
    res_valid: Out<bit,1>
    res_ready: In<bit,1>
    read_data: WordOut
    line_read_data: Out<bit,256>  // 읽은 라인 전체 (line 요청과 일반 읽기 모두)
    error: Out<bit,1>
}
seq MemoryAccess {
    pub clock: In<bit,1>
    pub reset: In<bit,1>
    pub ram_ready: In<bit,1>
    pub control: MemoryIO
    pub axi: AxiMaster
    pub instruction_invalidate: Out<bit,1> // 쓰기 응답 시 그 주소의 I-cache 라인 무효화
    pub instruction_invalidate_address: Out<bit,30>
    mut address: reg::ValueReg<WORD_SIZE>
    mut store_value: reg::ValueReg<WORD_SIZE>
    mut lookup: reg::ValueReg<1>  // load의 캐시 읽기 결과가 나온 클록
    mut refill: reg::ValueReg<1>  // 채운 라인을 다시 읽는 클록
    mut ar_pending: reg::ValueReg<1>
    mut r_pending: reg::ValueReg<1>
    mut aw_pending: reg::ValueReg<1>
    mut w_pending: reg::ValueReg<1>
    mut b_pending: reg::ValueReg<1>
    mut full: reg::ValueReg<1>
    mut bus_error: reg::ValueReg<1>
    mut error: reg::ValueReg<1>
    mut size: reg::ValueReg<2>
    mut zero_extend: reg::ValueReg<1>
    mut line: reg::ValueReg<1>
    mut line_mask: reg::ValueReg<4>
    mut line_store: reg::ValueReg<256>
    load_lane: LoadLane
    store_lane: StoreLane
    store_swap: LineSwap
    load_swap: LineSwap
    write_data: Mux<2,256>
    write_strobe: Mux<2,32>
    mut cache: cache::LineCache
    read_address: Mux<2,30>
    cache_data: Mux<2,256>
}
wire MemoryAccess {
    alias active = not(reset)
    alias accept = and(control.req_valid, control.req_ready)
    alias invalid_address = or(control.address[30..WORD_SIZE])
    alias bad = and(accept, invalid_address)
    alias start = and(accept, not(invalid_address))
    alias start_read = and(start, not(control.store))
    alias start_write = and(start, control.store)
    alias hit = and(lookup.out, cache.hit)
    alias miss = and(lookup.out, not(cache.hit))
    alias ar_fire = and(axi.read.arvalid, axi.read.arready)
    alias r_fire = and(axi.read.rvalid, axi.read.rready)
    alias read_done = and(r_fire, axi.read.rlast)
    alias aw_fire = and(axi.write.awvalid, axi.write.awready)
    alias w_fire = and(axi.write.wvalid, axi.write.wready)
    alias b_fire = and(axi.write.bvalid, axi.write.bready)
    alias r_error = or(axi.read.rresp[0..2], axi.read.rid[0..4], not(axi.read.rlast))
    alias b_error = or(axi.write.bresp[0..2], axi.write.bid[0..4])
    alias read_failed = and(read_done, or(bus_error.out, r_error))
    alias filled = and(active, read_done, not(bus_error.out), not(r_error))
    alias finish = or(bad, read_failed, b_fire)
    alias consume = and(control.res_valid, control.res_ready)
    clock => { size.clock, zero_extend.clock, address.clock, store_value.clock, lookup.clock, refill.clock, ar_pending.clock, r_pending.clock, aw_pending.clock, w_pending.clock, b_pending.clock, full.clock, bus_error.clock, error.clock, line.clock, line_mask.clock, line_store.clock }
    reset => { size.reset, zero_extend.reset, address.reset, store_value.reset, lookup.reset, refill.reset, ar_pending.reset, r_pending.reset, aw_pending.reset, w_pending.reset, b_pending.reset, full.reset, bus_error.reset, error.reset, line.reset, line_mask.reset, line_store.reset }

    // 요청을 받은 클록에 요청 주소로 캐시를 읽는다. store도 읽어 두고 B 응답 때 tag 일치를 본다.
    // load miss는 AXI로 라인을 읽어 채운 뒤 다시 읽는다. 응답 값은 캐시 읽기 결과에서 고른다.
    clock -> cache.clock
    reset -> cache.reset
    cache.read <- or(start, refill.out)
    read_address.select <- refill.out
    read_address.option[0] <- [ control.address[0..30] ]
    read_address.option[1] <- [ address.out[0..30] ]
    read_address.selected -> cache.read_address
    address.out[0..30] => { cache.compare_address, cache.write_address, cache.invalidate_address, instruction_invalidate_address }
    cache_data.select <- r_pending.out
    cache_data.option[0] <- write_data.selected
    cache_data.option[1] <- axi.read.rdata
    cache_data.selected -> cache.write_data
    cache.fill_en <- filled
    cache.store_en <- and(active, b_fire, not(b_error))
    write_strobe.selected -> cache.store_mask
    // 오류 응답이면 일부만 쓰였을 수 있는 그 라인을 지운다
    cache.invalidate <- and(active, b_fire, b_error)
    instruction_invalidate <- and(active, b_fire)
    lookup.w_en <- 1
    lookup.in <- or(start_read, refill.out)
    refill.w_en <- 1
    refill.in <- filled
    size.w_en <- accept
    size.in <- control.size
    zero_extend.w_en <- accept
    zero_extend.in <- control.zero_extend
    control.req_ready <- and(active, ram_ready, cache.ready, not(or(lookup.out, refill.out, ar_pending.out, r_pending.out, aw_pending.out, w_pending.out, b_pending.out, full.out)))
    address.w_en <- accept
    address.in <- control.address
    address.out[30..WORD_SIZE] -> OPENED
    store_value.w_en <- accept
    store_value.in <- control.write_data
    line.w_en <- accept
    line.in <- control.line
    line_mask.w_en <- accept
    line_mask.in <- control.line_mask
    line_store.w_en <- accept
    line_store.in <- control.line_write_data

    ar_pending.w_en <- 1
    ar_pending.in <- or(miss, and(ar_pending.out, not(ar_fire)))
    r_pending.w_en <- 1
    r_pending.in <- or(ar_fire, and(r_pending.out, not(read_done)))
    aw_pending.w_en <- 1
    aw_pending.in <- or(start_write, and(aw_pending.out, not(aw_fire)))
    w_pending.w_en <- 1
    w_pending.in <- or(start_write, and(w_pending.out, not(w_fire)))
    b_pending.w_en <- 1
    b_pending.in <- or(start_write, and(b_pending.out, not(b_fire)))
    // load hit 응답은 조회 클록에 바로 내고, 받지 않으면 full로 유지한다
    full.w_en <- 1
    full.in <- or(finish, and(or(full.out, hit), not(consume)))
    bus_error.w_en <- or(accept, r_fire)
    bus_error.in <- and(not(accept), or(bus_error.out, r_error))
    // 요청을 받을 때 지우고, 범위 오류나 AXI 오류 응답일 때 1
    error.w_en <- or(accept, finish)
    error.in <- or(bad, read_failed, and(b_fire, b_error))
    error.out -> control.error
    control.res_valid <- or(full.out, hit)

    // 접근 폭으로 내림 정렬하는 lane formatter와 32바이트 AXI beat를 분리한다.
    { axi.read.araddr[0..5] } <= 0
    axi.read.araddr[5..30] <- [ address.out[5..30] ]
    axi.read.arid <- 0
    axi.read.arlen <- 0
    { axi.read.arsize[0,2] } <= 1
    axi.read.arsize[1] <- 0
    axi.read.arburst[0] <- 1
    axi.read.arburst[1] <- 0
    axi.read.arlock <- 0
    axi.read.arcache <- 0
    axi.read.arprot <- 0
    axi.read.arqos <- 0
    axi.read.arvalid <- and(active, ar_pending.out)
    axi.read.rready <- and(active, r_pending.out)

    // 캐시는 다음 조회까지 읽기 결과를 유지하므로 읽은 값을 따로 저장하지 않는다
    cache.line -> load_lane.line
    address.out[0..5] -> load_lane.address
    size.out -> load_lane.size
    zero_extend.out -> load_lane.zero_extend
    load_lane.out -> control.read_data
    cache.line -> load_swap.in
    load_swap.out -> control.line_read_data

    { axi.write.awaddr[0..5] } <= 0
    axi.write.awaddr[5..30] <- [ address.out[5..30] ]
    axi.write.awid <- 0
    axi.write.awlen <- 0
    { axi.write.awsize[0,2] } <= 1
    axi.write.awsize[1] <- 0
    axi.write.awburst[0] <- 1
    axi.write.awburst[1] <- 0
    axi.write.awlock <- 0
    axi.write.awcache <- 0
    axi.write.awprot <- 0
    axi.write.awqos <- 0
    axi.write.awvalid <- and(active, aw_pending.out)
    axi.write.wvalid <- and(active, w_pending.out)
    axi.write.wlast <- 1
    axi.write.bready <- and(active, b_pending.out, not(aw_pending.out), not(w_pending.out))
    store_value.out -> store_lane.value
    address.out[0..5] -> store_lane.address
    size.out -> store_lane.size
    // 라인 쓰기: 바이트 순서를 바꾼 octa 4개, 마스크 비트 하나가 octa 하나(8바이트)를 고른다.
    line_store.out -> store_swap.in
    write_data.select <- line.out
    write_data.option[0] <- store_lane.data
    write_data.option[1] <- store_swap.out
    write_strobe.select <- line.out
    write_strobe.option[0] <- store_lane.mask
    { write_strobe.option[1][0..8] } <= line_mask.out[0]
    { write_strobe.option[1][8..16] } <= line_mask.out[1]
    { write_strobe.option[1][16..24] } <= line_mask.out[2]
    { write_strobe.option[1][24..32] } <= line_mask.out[3]
    write_data.selected -> axi.write.wdata
    write_strobe.selected -> axi.write.wstrb
}
