bundle MemoryIO { // MemoryAccess 입장, 요청/응답 각 한 건씩
    req_valid: In<bit,1>
    req_ready: Out<bit,1>
    address: WordIn
    store: In<bit,1>
    size: In<bit,2>  // log2(bytes): 0/1/2/3
    zero_extend: In<bit,1>
    write_data: WordIn
    res_valid: Out<bit,1>
    res_ready: In<bit,1>
    read_data: WordOut
    error: Out<bit,1>
}
seq MemoryAccess {
    pub clock: In<bit,1>
    pub reset: In<bit,1>
    pub ram_ready: In<bit,1>
    pub control: MemoryIO
    pub axi: AxiMaster
    pub instruction_invalidate: Out<bit,1> // 쓰기 응답 시 I-cache 무효화
    mut address: reg::ValueReg<WORD_SIZE>
    mut store_value: reg::ValueReg<WORD_SIZE>
    mut load_value: reg::ValueReg<WORD_SIZE>
    mut ar_pending: reg::ValueReg<1>
    mut r_pending: reg::ValueReg<1>
    mut aw_pending: reg::ValueReg<1>
    mut w_pending: reg::ValueReg<1>
    mut b_pending: reg::ValueReg<1>
    mut full: reg::ValueReg<1>
    mut bus_error: reg::ValueReg<1>
    mut error: reg::ValueReg<1>
    mut size: reg::ValueReg<2>
    mut zero_extend: reg::ValueReg<1>
    load_lane: LoadLane
    store_lane: StoreLane
    mut cache: cache::LineCache8
    line_source: Mux<2,256>
    load_address: Mux<2,5>
    load_size: Mux<2,2>
    load_unsigned: Mux<2,1>
}
wire MemoryAccess {
    alias active = not(reset)
    alias accept = and(control.req_valid, control.req_ready)
    alias invalid_address = or(control.address[30..WORD_SIZE])
    alias bad = and(accept, invalid_address)
    alias cached = and(accept, not(invalid_address), not(control.store), cache.hit)
    alias start_read = and(accept, not(invalid_address), not(control.store), not(cache.hit))
    alias start_write = and(accept, not(invalid_address), control.store)
    alias ar_fire = and(axi.read.arvalid, axi.read.arready)
    alias r_fire = and(axi.read.rvalid, axi.read.rready)
    alias read_done = and(r_fire, axi.read.rlast)
    alias aw_fire = and(axi.write.awvalid, axi.write.awready)
    alias w_fire = and(axi.write.wvalid, axi.write.wready)
    alias b_fire = and(axi.write.bvalid, axi.write.bready)
    alias r_error = or(axi.read.rresp[0..2], axi.read.rid[0..4], not(axi.read.rlast))
    alias b_error = or(axi.write.bresp[0..2], axi.write.bid[0..4])
    alias finish = or(bad, read_done, b_fire, cached)
    alias consume = and(control.res_valid, control.res_ready)
    clock => { size.clock, zero_extend.clock, address.clock, store_value.clock, load_value.clock, ar_pending.clock, r_pending.clock, aw_pending.clock, w_pending.clock, b_pending.clock, full.clock, bus_error.clock, error.clock }
    reset => { size.reset, zero_extend.reset, address.reset, store_value.reset, load_value.reset, ar_pending.reset, r_pending.reset, aw_pending.reset, w_pending.reset, b_pending.reset, full.reset, bus_error.reset, error.reset }
    clock -> cache.clock
    reset -> cache.reset
    cache.invalidate <- and(active, b_fire, b_error)
    control.address[0..30] -> cache.lookup_address
    address.out[0..30] -> cache.update_address
    cache.fill_en <- and(active, read_done, not(bus_error.out), not(r_error))
    cache.fill_data <- axi.read.rdata
    cache.store_en <- and(active, b_fire, not(b_error))
    cache.store_data <- store_lane.data
    cache.store_mask <- store_lane.mask
    instruction_invalidate <- and(active, b_fire)
    line_source.select <- cached
    line_source.option[0] <- axi.read.rdata
    line_source.option[1] <- cache.line
    load_address.select <- cached
    load_address.option[0] <- address.out[0..5]
    load_address.option[1] <- control.address[0..5]
    load_size.select <- cached
    load_size.option[0] <- size.out
    load_size.option[1] <- control.size
    load_unsigned.select <- cached
    load_unsigned.option[0] <- zero_extend.out
    load_unsigned.option[1] <- control.zero_extend
    size.w_en <- accept
    size.in <- control.size
    zero_extend.w_en <- accept
    zero_extend.in <- control.zero_extend
    control.req_ready <- and(active, ram_ready, not(or(ar_pending.out, r_pending.out, aw_pending.out, w_pending.out, b_pending.out, full.out)))
    address.w_en <- accept
    address.in <- control.address
    address.out[30..WORD_SIZE] -> OPENED
    store_value.w_en <- accept
    store_value.in <- control.write_data

    ar_pending.w_en <- 1
    ar_pending.in <- or(start_read, and(ar_pending.out, not(ar_fire)))
    r_pending.w_en <- 1
    r_pending.in <- or(ar_fire, and(r_pending.out, not(read_done)))
    aw_pending.w_en <- 1
    aw_pending.in <- or(start_write, and(aw_pending.out, not(aw_fire)))
    w_pending.w_en <- 1
    w_pending.in <- or(start_write, and(w_pending.out, not(w_fire)))
    b_pending.w_en <- 1
    b_pending.in <- or(start_write, and(b_pending.out, not(b_fire)))
    full.w_en <- 1
    full.in <- or(finish, and(full.out, not(consume)))
    bus_error.w_en <- or(accept, r_fire)
    bus_error.in <- and(not(accept), or(bus_error.out, r_error))
    error.w_en <- finish
    error.in <- or(bad, and(read_done, or(bus_error.out, r_error)), and(b_fire, b_error))
    error.out -> control.error
    full.out -> control.res_valid
    load_value.out -> control.read_data

    // 접근 폭으로 내림 정렬하는 lane formatter와 32바이트 AXI beat를 분리한다.
    { axi.read.araddr[0..5] } <= 0
    axi.read.araddr[5..30] <- [ address.out[5..30] ]
    axi.read.arid <- 0
    axi.read.arlen <- 0
    { axi.read.arsize[0,2] } <= 1
    axi.read.arsize[1] <- 0
    axi.read.arburst[0] <- 1
    axi.read.arburst[1] <- 0
    axi.read.arlock <- 0
    axi.read.arcache <- 0
    axi.read.arprot <- 0
    axi.read.arqos <- 0
    axi.read.arvalid <- and(active, ar_pending.out)
    axi.read.rready <- and(active, r_pending.out)

    line_source.selected -> load_lane.line
    load_address.selected -> load_lane.address
    load_size.selected -> load_lane.size
    load_unsigned.selected -> load_lane.zero_extend
    load_value.w_en <- or(read_done, cached)
    load_value.in <- load_lane.out

    { axi.write.awaddr[0..5] } <= 0
    axi.write.awaddr[5..30] <- [ address.out[5..30] ]
    axi.write.awid <- 0
    axi.write.awlen <- 0
    { axi.write.awsize[0,2] } <= 1
    axi.write.awsize[1] <- 0
    axi.write.awburst[0] <- 1
    axi.write.awburst[1] <- 0
    axi.write.awlock <- 0
    axi.write.awcache <- 0
    axi.write.awprot <- 0
    axi.write.awqos <- 0
    axi.write.awvalid <- and(active, aw_pending.out)
    axi.write.wvalid <- and(active, w_pending.out)
    axi.write.wlast <- 1
    axi.write.bready <- and(active, b_pending.out, not(aw_pending.out), not(w_pending.out))
    store_value.out -> store_lane.value
    address.out[0..5] -> store_lane.address
    size.out -> store_lane.size
    store_lane.data -> axi.write.wdata
    store_lane.mask -> axi.write.wstrb
}
