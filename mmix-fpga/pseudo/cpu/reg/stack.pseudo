// 범용 슬롯은 512개다. 슬롯 0..255는 로컬 ring(크기 256)이고, 글로벌 $k는 슬롯 256+k다.
// ring 크기가 G와 무관하므로 alpha = (rO/8) mod 256, gamma = (rS/8) mod 256은 rO, rS의 비트 그대로다.

bundle StackDirectIO {  // Registers 입장
    rJ_out: WordOut
    rJ_in: WordIn
    rJ_w_en: In<bit,1>
    rO_out: WordOut
    rO_in: WordIn
    rO_w_en: In<bit,1>
    rS_out: WordOut
    rS_in: WordIn
    rS_w_en: In<bit,1>
    rG_out: Out<bit,8>
    rG_in: In<bit,8>
    rG_w_en: In<bit,1>
    rL_out: Out<bit,8>
    rL_in: In<bit,8>
    rL_w_en: In<bit,1>
    rT_out: WordOut  // TRAP의 목표 주소
}

// 논리 번호 k를 슬롯으로 변환한다. k>=G는 256+k, k<L은 (alpha+k) mod 256, 나머지는 marginal.
comb RegisterWindow {
    pub sel: In<bit,8>
    pub g: In<bit,8>
    pub l: In<bit,8>
    pub alpha: In<bit,8>
    pub slot: Out<bit,9>
    pub marginal: Out<bit,1>
    global_compare: Adder<8>
    local_compare: Adder<8>
    ring_add: Adder<8>
    slot_mux: Mux<2,8>
}

wire RegisterWindow {
    alias is_global = global_compare.c_out
    alias is_local = not(local_compare.c_out)

    sel -> global_compare.a
    global_compare.b <- not(g)
    global_compare.c_in <- 1
    global_compare.sum -> OPENED

    sel -> local_compare.a
    local_compare.b <- not(l)
    local_compare.c_in <- 1
    local_compare.sum -> OPENED

    alpha -> ring_add.a
    sel -> ring_add.b
    ring_add.c_in <- 0
    ring_add.c_out -> OPENED

    slot_mux.select <- is_global
    slot_mux.option[0] <- ring_add.sum
    slot_mux.option[1] <- sel
    slot[0..8] <- slot_mux.selected
    slot[8] <- is_global
    marginal <- and(not(is_global), not(is_local))
}
