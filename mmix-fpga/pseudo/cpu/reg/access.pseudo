// 실제 의미가 있는 특수 레지스터만 허용한다.
// 8,9,12..18의 시스템 레지스터는 해당 서브시스템 구현 전까지 미지원.
// rO, rS는 읽기 전용이다. rG, rL은 PUT 값에 사양과 구현 제약을 적용한다.
comb SpecialAccess {
    pub get: In<bit,1>
    pub put: In<bit,1>
    pub index: In<bit,5>
    pub value: WordIn
    pub g: In<bit,8>
    pub l: In<bit,8>
    pub allowed: Out<bit,1>
    select: Decoder<5,32>
    value_vs_l: Adder<8>
}

wire SpecialAccess {
    index -> select.in
    alias readable = or(select.out[0..8,10,11,19..32])
    alias writable = or(select.out[0..8,21..32])
    alias unsupported_ra_bits = or(value[0..6,8..14,16..WORD_SIZE])
    alias value_high = or(value[8..WORD_SIZE])
    alias value_at_least_32 = or(value[5..8])
    alias value_at_least_l = value_vs_l.c_out
    alias ring_changes = or(xor(value[7], g[7]), xor(or(value[7], value[6]), or(g[7], g[6])))
    alias put_g_ok = and(
        not(value_high),
        value_at_least_32,
        value_at_least_l,
        or(not(ring_changes), not(or(l[0..8]))),
    )
    value_vs_l.a <- [ value[0..8] ]
    value_vs_l.b <- not(l)
    value_vs_l.c_in <- 1
    value_vs_l.sum -> OPENED
    allowed <- or(
        not(or(get, put)),
        and(get, readable),
        and(put, writable, not(and(select.out[21], unsupported_ra_bits))),
        and(put, select.out[19], put_g_ok),
        and(put, select.out[20]),
    )
    select.out[8,9,12..19] -> OPENED
}
