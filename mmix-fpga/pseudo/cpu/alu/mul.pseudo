// 곱셈 유닛. 즉치는 제어유닛이 arg로 주입
// 곱은 PipeMultiplier(입력 레지스터 + 곱 뒤 3단)로 계산해 4클록 뒤 나온다.
// go인 클록이 4번 지난 뒤부터 ready=1이다. 그동안 arg는 바뀌지 않아야 한다(EX가 멈춰 유지한다).

seq Mul {
    pub clock: In<bit,1>
    pub go:   In<bit,1>   // 피연산자가 유효하고 이 유닛이 선택된 클록
    pub new:  In<bit,1>   // 새 명령의 첫 클록. 진행 횟수를 지운다
    pub ready: Out<bit,1>
    pub op:   In<bit,1>
    pub arg1: WordIn
    pub arg2: WordIn
    pub res:  WordOut
    pub v:    Out<bit,1>  // MUL signed 오버플로
    pub reset: In<bit,1>

    pub rH:      WordOut  // MULU 곱 상위 64비트
    pub rH_w_en: Out<bit,1>

    sel_op:     Decoder<1,2>
    mut multiplier: PipeMultiplier<WORD_SIZE,3>
    mut count: reg::ValueReg<3>  // go인 클록 수(4에서 멈춤)
    count_step: Adder<3>
    count_next: Mux<2,3>
}

wire Mul {
    alias {
        MUL = 0
        MULU = 1
    }
    alias hi_all_one  = and(multiplier.hi[0..WORD_SIZE], multiplier.lo[WORD_MSB])
    alias hi_all_zero = not(or(multiplier.hi[0..WORD_SIZE], multiplier.lo[WORD_MSB]))
    alias at_latency = and(count.out[2], not(count.out[1]), not(count.out[0]))  // 4

    clock => { multiplier.clock, count.clock }
    reset -> count.reset
    op -> sel_op.in

    multiplier.a      <- arg1
    multiplier.b      <- arg2
    multiplier.signed <- sel_op.out[MUL]

    // new인 클록은 0부터 다시 센다. go인 클록마다 1씩, 4에서 멈춘다.
    count_step.a <- count.out
    count_step.b <- 0
    count_step.c_in <- and(go, not(at_latency))
    count_step.c_out -> OPENED
    count_next.select <- new
    count_next.option[0] <- count_step.sum
    count_next.option[1][0] <- go
    { count_next.option[1][1..3] } <= 0
    count.w_en <- 1
    count_next.selected -> count.in
    ready <- at_latency

    multiplier.lo -> res
    multiplier.hi -> rH
    rH_w_en <- sel_op.out[MULU]

    // V: signed 곱이 64비트를 벗어남 (hi 전체와 lo 최상위 비트가 모두 같지 않음)
    v <- and(sel_op.out[MUL], not(or(hi_all_one, hi_all_zero)))
}
