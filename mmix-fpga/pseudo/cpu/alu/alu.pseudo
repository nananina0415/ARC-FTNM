// 번들은 기본적으로 가지고 있는쪽 입장에서 인아웃
// *<번들>은 인아웃반전. 포인터처럼 밖에 있는 번들을 가리키는(연결되는) 용도

bundle AluSelect: In<bit,3>

// rA 중 정수연산에 필요한 비트만. [0..4] = rA의 비트 6,7,14,15
// [0]: V event, [1]: D event, [2]: V enable, [3]: D enable
bundle RaBits: In<bit,4>

// Registers의 alu_direct가 *AluDirectIO로 가진다. rD·rM은 EX의 ALU가 읽고,
// rA·rH·rR은 연산 후처리(Control의 POST)가 쓴다.
bundle AluDirectIO {  // 레지스터를 읽고 쓰는 쪽 입장
    rA_in:   RaBits
    rA_out:  *RaBits
    rA_w_en: Out<bit,1>

    rD_in:   WordIn      // DIVU 피제수 상위 64비트
    rM_in:   WordIn      // MUX 마스크

    rH_out:  WordOut     // MULU 곱 상위 64비트
    rH_w_en: Out<bit,1>
    rR_out:  WordOut     // DIV/DIVU 나머지
    rR_w_en: Out<bit,1>
}

// MUL·DIV는 여러 클록 걸리는 순차 유닛이라 Alu도 seq다. 나머지 유닛은 같은 클록에 결과를 낸다.
// Alu는 연산만 한다. 결과와 V·D 이벤트, rH·rR 값을 내고, 상태 쓰기와 trip 판정은 Control의 POST가 한다.
// 내부에 번들 삽입시 pub 붙이기

seq Alu {
    pub clock: In<bit,1>
    pub reset: In<bit,1>
    pub go: In<bit,1>     // EX 명령의 피연산자가 유효한 클록
    pub new: In<bit,1>    // EX에 새 명령이 들어온 첫 클록
    pub ready: Out<bit,1>  // 선택된 유닛의 결과가 유효. MUL·DIV 외에는 항상 1
    pub unsupported: Out<bit,1>  // 실행 시점에 판정한 미지원(DIVU의 rD != 0)
    pub alu_sel: AluSelect
    pub op: In<bit,4>  // 선택된 하위 유닛 안의 연산
    pub arg1: WordIn
    pub arg2: WordIn
    pub res:  WordOut
    pub res_w_en: Out<bit,1>  // res를 $X에 쓰는 연산이면 1(거짓 조건의 CS*는 0)

    pub rD: WordIn  // DIVU 피제수 상위 64비트
    pub rM: WordIn  // MUX 마스크
    pub v: Out<bit,1>  // 선택된 유닛의 V(오버플로) 이벤트. ready일 때만 의미가 있다
    pub d: Out<bit,1>  // 선택된 유닛의 D(0으로 나눔) 이벤트
    pub rH: WordOut  // MULU 곱 상위 64비트
    pub rH_w_en: Out<bit,1>  // MULU면 1
    pub rR: WordOut  // DIV/DIVU 나머지
    pub rR_w_en: Out<bit,1>  // DIV/DIVU면 1

    addsub: AddSub
    mut mul: Mul
    mut div: Div
    comp: Compare
    bitwise: Bitwise
    shift: Shift
    cond: Cond

    alu_res_mux: Mux<7,WORD_SIZE>
    alu_w_en_mux: Mux<7,1>
    sel_alu_op: Decoder<3,8>  // 선택된 유닛의 쓰기/예외 신호만 통과시키는 용도
}

// wire: 순차회로나 조합회로의 내부 배선

wire Alu {
    alias {
        ADD_SUB = 0,
        MUL = 1,
        DIV = 2,
        COMP = 3,
        BITWISE = 4,
        SHIFT = 5,
        COND = 6,
    }
    alu_sel[0,1,2] -> alu_res_mux.select[0,1,2]
    op    => { addsub.op, bitwise.op, cond.op }
    op[0] => { mul.op, div.op, comp.op }
    op[0,1] -> shift.op
    [ alu_res_mux.option[..] ] <- [ // 방향 반대로
        addsub.res,
        mul.res,
        div.res,
        comp.res,
        bitwise.res,
        shift.res,
        cond.res,
    ]
    alu_res_mux.selected -> res

    // 결과 쓰기 여부. 항상 쓰는 유닛은 1
    alu_sel[0,1,2] -> alu_w_en_mux.select[0,1,2]
    { alu_w_en_mux.option[ADD_SUB, MUL, DIV, COMP, BITWISE, SHIFT] } <= 1
    alu_w_en_mux.option[COND] <- cond.res_w_en
    alu_w_en_mux.selected -> res_w_en

    arg1[0..WORD_SIZE] => { // 각각배선
        addsub.arg1,
        mul.arg1,
        div.arg1,
        comp.arg1,
        bitwise.arg1,
        shift.arg1,
        cond.arg1,
    }
    arg2[0..WORD_SIZE] => {
        addsub.arg2,
        mul.arg2,
        div.arg2,
        comp.arg2,
        bitwise.arg2,
        shift.arg2,
        cond.arg2,
    }

    alu_sel[0,1,2] -> sel_alu_op.in[0,1,2]
    sel_alu_op.out[COMP,BITWISE,COND,7] -> OPENED

    // 여러 클록 유닛
    clock => { mul.clock, div.clock }
    reset => { mul.reset, div.reset }
    new => { mul.new, div.new }
    mul.go <- and(go, sel_alu_op.out[MUL])
    div.go <- and(go, sel_alu_op.out[DIV])
    ready <- or(
        and(sel_alu_op.out[MUL], mul.ready),
        and(sel_alu_op.out[DIV], div.ready),
        not(or(sel_alu_op.out[MUL], sel_alu_op.out[DIV])),
    )
    unsupported <- and(sel_alu_op.out[DIV], div.unsupported)

    // 특수 레지스터
    rD -> div.rD
    rM -> bitwise.rM

    mul.rH -> rH
    rH_w_en <- and(mul.rH_w_en, sel_alu_op.out[MUL])
    div.rR -> rR
    rR_w_en <- and(div.rR_w_en, sel_alu_op.out[DIV])

    // 예외 이벤트: 유닛들이 동시에 계산하므로 선택된 유닛의 이벤트만 낸다
    v <- or(
        and(addsub.v, sel_alu_op.out[ADD_SUB]),
        and(mul.v,    sel_alu_op.out[MUL]),
        and(div.v,    sel_alu_op.out[DIV]),
        and(shift.v,  sel_alu_op.out[SHIFT]),
    )
    d <- and(div.d, sel_alu_op.out[DIV])
}

// D/V 예외 발생 시 enable=0이면 event 비트 설정, enable=1이면 trip_req.
// Control의 POST가 ALU 명령의 이벤트와 현재 rA로 판정한다.
comb ExcCheck {
    pub d: In<bit,1>
    pub v: In<bit,1>

    pub ra_in:  RaBits
    pub ra_out: *RaBits
    pub ra_w_en: Out<bit,1>
    pub trip_req: Out<bit,1>
}

wire ExcCheck {
    ra_out[0] <- or(ra_in[0], and(v, not(ra_in[2])))
    ra_out[1] <- or(ra_in[1], and(d, not(ra_in[3])))
    ra_out[2] <- ra_in[2]
    ra_out[3] <- ra_in[3]

    ra_w_en  <- or(and(v, not(ra_in[2])), and(d, not(ra_in[3])))
    trip_req <- or(and(v, ra_in[2]), and(d, ra_in[3]))
}
