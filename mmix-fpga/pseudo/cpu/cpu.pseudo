alias Alu = ::alu::Alu
alias Registers = ::reg::Registers
alias Fetch = ::fetch::Fetch
alias FetchIO = ::fetch::FetchIO
alias InstructionDecode = ::decode::InstructionDecode
alias DecodeControl = ::decode::DecodeControl
alias Control = ::control::Control
alias MemoryAccess = ::memory::MemoryAccess
alias ReadSelect = ::memory::ReadSelect

seq Cpu {
    pub clock: In<bit,1>  // MIG.ui_clk
    pub reset: In<bit,1>  // 동기 active-high. MIG.ui_clk_sync_rst 및 AXI reset과 함께 사용
    pub init_calib_complete: In<bit,1>  // MIG 출력. 1일 때만 새 페치 요청 수락
    pub axi: AxiMaster   // FPGA RAM controller의 AXI slave에 연결

    pub decoded: DecodeControl  // PRE 단계 명령의 해독 결과
    pub done: Out<bit,1>  // HALT 명령으로 정지
    pub fault: Out<bit,1>  // 오류로 정지
    pub fault_reason: Out<bit,3>  // [0] 페치/데이터 접근, [1] 미지원, [2] trip
    pub trip_req: Out<bit,1>    // POST의 유효한 ALU 명령이 trip을 일으킨다. 제어유닛이 처리

    mut alu: Alu
    mut reg: Registers
    mut fetch: Fetch
    mut control: Control
    mut memory: MemoryAccess
    mut read_select: ReadSelect
    address_add: Adder<WORD_SIZE>
    read1_slot: Mux<2,9>  // 레지스터 스택 내부 읽기는 9비트 슬롯을 직접 지정
    ex_value_mux: Mux<2,WORD_SIZE>  // EX 결과: ALU / 주소
    store_data_mux: Mux<2,WORD_SIZE>
    special_source: Mux<2,WORD_SIZE>
    special_select: Mux<2,5>  // SAVE/UNSAVE는 StackControl이 번호를 지정
    special_drive: Mux<2,WORD_SIZE>  // UNSAVE는 메모리 값을 버스에 구동
    special_access: ::reg::SpecialAccess
    special_driver: TriState
    id_decode: InstructionDecode  // ID 단계: 페치 응답
    pre_decode: InstructionDecode  // PRE 단계 명령
    post_decode: InstructionDecode  // POST 단계 명령
    arg1_mux: Mux<3,WORD_SIZE>  // PRE: $r1 / unsigned Y / 0
    arg2_mux: Mux<3,WORD_SIZE>  // PRE: $Z / unsigned Z / shifted YZ
}

wire Cpu {
    clock => { reg.clock, fetch.clock, control.clock, memory.clock, read_select.clock, alu.clock }
    reset => { reg.reset, fetch.reset, control.reset, memory.reset, read_select.reset, alu.reset }
    init_calib_complete => { fetch.ram_ready, memory.ram_ready }
    memory.instruction_invalidate -> fetch.invalidate
    memory.instruction_invalidate_address -> fetch.invalidate_address
    control.done -> done
    control.fault -> fault
    control.fault_reason -> fault_reason
    control.executed -> OPENED  // 검증 하네스가 관찰한다
    pre_decode.control.valid -> control.decoded_valid
    pre_decode.control.halt -> control.decoded_halt
    pre_decode.control.memory -> control.decoded_memory
    pre_decode.control.store -> control.decoded_store
    pre_decode.control.store_constant -> control.decoded_store_constant
    pre_decode.control.address_get -> control.decoded_geta
    pre_decode.control.special_get -> control.decoded_get
    pre_decode.control.special_put -> control.decoded_put
    pre_decode.control.branch -> control.decoded_branch
    pre_decode.control.branch_unconditional -> control.branch_unconditional
    pre_decode.control.branch_condition -> control.branch_condition
    pre_decode.control.branch_offset -> control.branch_offset
    pre_decode.control.alu_sel -> control.decoded_alu_sel
    pre_decode.control.op -> control.decoded_op
    control.decoded_arg1_reg <- and(not(pre_decode.control.arg1_imm), not(pre_decode.control.arg1_zero))
    control.decoded_arg2_reg <- and(not(pre_decode.control.arg2_imm), not(pre_decode.control.arg2_wyde))
    control.trip -> trip_req
    control.alu_go -> alu.go
    control.alu_new -> alu.new
    alu.ready -> control.alu_ready
    alu.res_w_en -> control.alu_write
    alu.v -> control.alu_v
    alu.d -> control.alu_d
    alu.rH -> control.alu_rH
    alu.rH_w_en -> control.alu_rH_write
    alu.rR -> control.alu_rR
    alu.rR_w_en -> control.alu_rR_write

    pre_decode.control.writes_x -> control.decoded_writes_x
    pre_decode.control.push -> control.decoded_push
    pre_decode.control.go -> control.decoded_go
    pre_decode.control.pop -> control.decoded_pop
    pre_decode.control.put_g -> control.decoded_put_g
    pre_decode.control.save -> control.decoded_save
    pre_decode.control.unsave -> control.decoded_unsave
    pre_decode.control.trap -> control.decoded_trap
    pre_decode.control.swym -> control.decoded_swym
    pre_decode.control.w_sel -> control.decoded_x
    special_source.selected -> control.pre_special

    // POST 해독기는 상태 쓰기, 레지스터 스택, 메모리 요청, 정지·방향 전환에 쓴다.
    control.post_instruction -> post_decode.instruction
    post_decode.instruction_valid <- and(control.post_valid, not(reset))
    post_decode.control.halt -> control.post_halt
    post_decode.control.memory -> control.post_memory
    post_decode.control.store -> control.post_store
    post_decode.control.memory_size -> control.post_memory_size
    post_decode.control.load_unsigned -> control.post_load_unsigned
    post_decode.control.special_get -> control.post_get
    post_decode.control.special_put -> control.post_put
    post_decode.control.put_l -> control.post_put_l
    post_decode.control.branch -> control.post_branch
    post_decode.control.branch_unconditional -> control.post_branch_unconditional
    post_decode.control.go -> control.post_jump_go
    post_decode.control.writes_x -> control.post_writes_x
    post_decode.control.push -> control.post_push
    post_decode.control.push_go -> control.post_push_go
    post_decode.control.pop -> control.post_pop
    post_decode.control.put_g -> control.post_put_g
    post_decode.control.save -> control.post_save
    post_decode.control.unsave -> control.post_unsave
    post_decode.control.trap -> control.post_trap
    special_access.allowed -> control.post_allowed
    post_decode.control.valid -> OPENED
    post_decode.control.unsupported -> OPENED
    post_decode.control.store_constant -> OPENED
    post_decode.control.address_get -> OPENED
    post_decode.control.special_immediate -> OPENED
    post_decode.control.branch_condition -> OPENED
    post_decode.control.branch_offset -> OPENED
    post_decode.control.swym -> OPENED
    post_decode.control.alu_sel -> OPENED
    post_decode.control.op -> OPENED
    post_decode.control.r1_sel -> OPENED
    post_decode.control.r2_sel -> OPENED
    post_decode.control.arg1_imm -> OPENED
    post_decode.control.arg2_imm -> OPENED
    post_decode.control.arg1_zero -> OPENED
    post_decode.control.arg2_wyde -> OPENED
    post_decode.control.imm_y -> OPENED
    post_decode.control.imm_z -> OPENED
    post_decode.control.imm_yz -> OPENED
    post_decode.control.imm_x -> OPENED

    reg.stack.rT_out -> control.stack_regs.rT_out
    reg.special.data -> control.stack_special_data
    reg.general.r1_data -> control.stack_r1_data
    reg.general.r1_valid -> control.stack_r1_valid
    reg.special.valid -> control.stack_special_valid
    reg.stack.rJ_out -> control.stack_regs.rJ_out
    control.stack_regs.rJ_in -> reg.stack.rJ_in
    control.stack_regs.rJ_w_en -> reg.stack.rJ_w_en
    reg.stack.rO_out -> control.stack_regs.rO_out
    control.stack_regs.rO_in -> reg.stack.rO_in
    control.stack_regs.rO_w_en -> reg.stack.rO_w_en
    reg.stack.rS_out -> control.stack_regs.rS_out
    control.stack_regs.rS_in -> reg.stack.rS_in
    control.stack_regs.rS_w_en -> reg.stack.rS_w_en
    reg.stack.rG_out -> control.stack_regs.rG_out
    control.stack_regs.rG_in -> reg.stack.rG_in
    control.stack_regs.rG_w_en -> reg.stack.rG_w_en
    reg.stack.rL_out -> control.stack_regs.rL_out
    control.stack_regs.rL_in -> reg.stack.rL_in
    control.stack_regs.rL_w_en -> reg.stack.rL_w_en
    control.stack_r1_physical -> reg.general.r1_physical
    control.stack_w_en -> reg.general.stack_w_en
    control.stack_w_slot -> reg.general.stack_w_sel
    control.stack_w_data -> reg.general.stack_w_data

    // GET/PUT/SAVE의 허용 범위는 POST 명령의 번호와 값으로 판정한다.
    reg.stack.rG_out -> special_access.g
    reg.stack.rL_out -> special_access.l
    post_decode.control.save -> special_access.save
    post_decode.control.w_sel -> special_access.x
    post_decode.control.special_get -> special_access.get
    post_decode.control.special_put -> special_access.put
    post_decode.control.special_index -> special_access.index
    control.post_special_value -> special_access.value
    // PUT 값은 PRE에서 고르고 EX·POST로 넘긴다.
    special_source.select <- pre_decode.control.special_immediate
    special_source.option[0] <- control.pre_value_r2
    special_source.option[1] <- pre_decode.control.imm_z
    // 특수 레지스터 버스는 POST가 쓴다.
    reg.special.enable <- or(control.special_get_en, control.special_put_en, control.stack_special_en)
    special_select.select <- control.stack_special_en
    special_select.option[0] <- post_decode.control.special_index
    special_select.option[1] <- control.stack_special_sel
    special_select.selected -> reg.special.sel
    reg.special.rw <- and(not(post_decode.control.special_put), not(control.stack_special_write))
    special_driver.enable <- or(control.special_put_en, control.stack_special_write)
    special_drive.select <- control.stack_special_write
    special_drive.option[0] <- control.post_special_value
    special_drive.option[1] <- control.stack_special_value
    special_drive.selected -> special_driver.in
    special_driver.out -> reg.special.data

    // ID 해독기는 레지스터 읽기 번호와 분기 예측에, PRE 해독기는 EX 제어와 판정에 쓴다.
    fetch.control.instruction -> id_decode.instruction
    id_decode.instruction_valid <- and(fetch.control.res_valid, not(fetch.control.error), not(reset))
    id_decode.control.r1_sel -> control.id_r1_sel
    id_decode.control.r2_sel -> control.id_r2_sel
    id_decode.control.w_sel -> control.id_x_sel
    id_decode.control.branch -> control.id_branch
    id_decode.control.branch_unconditional -> control.id_unconditional
    id_decode.control.branch_offset -> control.id_offset
    id_decode.control.valid -> OPENED
    id_decode.control.unsupported -> OPENED
    id_decode.control.halt -> OPENED
    id_decode.control.memory -> OPENED
    id_decode.control.store -> OPENED
    id_decode.control.memory_size -> OPENED
    id_decode.control.load_unsigned -> OPENED
    id_decode.control.store_constant -> OPENED
    id_decode.control.address_get -> OPENED
    id_decode.control.special_get -> OPENED
    id_decode.control.special_put -> OPENED
    id_decode.control.special_immediate -> OPENED
    id_decode.control.special_index -> OPENED
    id_decode.control.branch_condition -> OPENED
    id_decode.control.writes_x -> OPENED
    id_decode.control.push -> OPENED
    id_decode.control.push_go -> OPENED
    id_decode.control.go -> OPENED
    id_decode.control.pop -> OPENED
    id_decode.control.put_g -> OPENED
    id_decode.control.put_l -> OPENED
    id_decode.control.save -> OPENED
    id_decode.control.unsave -> OPENED
    id_decode.control.trap -> OPENED
    id_decode.control.swym -> OPENED
    id_decode.control.alu_sel -> OPENED
    id_decode.control.op -> OPENED
    id_decode.control.arg1_imm -> OPENED
    id_decode.control.arg2_imm -> OPENED
    id_decode.control.arg1_zero -> OPENED
    id_decode.control.arg2_wyde -> OPENED
    id_decode.control.imm_y -> OPENED
    id_decode.control.imm_z -> OPENED
    id_decode.control.imm_yz -> OPENED
    id_decode.control.imm_x -> OPENED
    control.pre_instruction -> pre_decode.instruction
    pre_decode.instruction_valid <- and(control.pre_valid, not(reset))
    pre_decode.control.valid -> decoded.valid
    pre_decode.control.unsupported -> decoded.unsupported
    pre_decode.control.halt -> decoded.halt
    pre_decode.control.memory -> decoded.memory
    pre_decode.control.store -> decoded.store
    pre_decode.control.memory_size -> decoded.memory_size
    pre_decode.control.load_unsigned -> decoded.load_unsigned
    pre_decode.control.store_constant -> decoded.store_constant
    pre_decode.control.address_get -> decoded.address_get
    pre_decode.control.special_get -> decoded.special_get
    pre_decode.control.special_put -> decoded.special_put
    pre_decode.control.special_immediate -> decoded.special_immediate
    pre_decode.control.special_index -> decoded.special_index
    pre_decode.control.branch -> decoded.branch
    pre_decode.control.branch_unconditional -> decoded.branch_unconditional
    pre_decode.control.branch_condition -> decoded.branch_condition
    pre_decode.control.branch_offset -> decoded.branch_offset
    pre_decode.control.writes_x -> decoded.writes_x
    pre_decode.control.push -> decoded.push
    pre_decode.control.push_go -> decoded.push_go
    pre_decode.control.go -> decoded.go
    pre_decode.control.pop -> decoded.pop
    pre_decode.control.put_g -> decoded.put_g
    pre_decode.control.put_l -> decoded.put_l
    pre_decode.control.save -> decoded.save
    pre_decode.control.unsave -> decoded.unsave
    pre_decode.control.trap -> decoded.trap
    pre_decode.control.swym -> decoded.swym
    pre_decode.control.alu_sel -> decoded.alu_sel
    pre_decode.control.op -> decoded.op
    pre_decode.control.r1_sel -> decoded.r1_sel
    pre_decode.control.r2_sel -> decoded.r2_sel
    pre_decode.control.w_sel -> decoded.w_sel
    pre_decode.control.arg1_imm -> decoded.arg1_imm
    pre_decode.control.arg2_imm -> decoded.arg2_imm
    pre_decode.control.arg1_zero -> decoded.arg1_zero
    pre_decode.control.arg2_wyde -> decoded.arg2_wyde
    pre_decode.control.imm_y -> decoded.imm_y
    pre_decode.control.imm_z -> decoded.imm_z
    pre_decode.control.imm_yz -> decoded.imm_yz
    pre_decode.control.imm_x -> decoded.imm_x

    // EX: PRE가 담아 둔 연산 선택과 피연산자로 연산한다.
    control.ex_alu_sel -> alu.alu_sel
    control.ex_op -> alu.op
    control.arg1 -> alu.arg1
    control.arg2 -> alu.arg2
    read1_slot.select <- control.stack_r1_physical
    read1_slot.option[0][0..8] <- control.read_r1_sel
    read1_slot.option[0][8] <- 0
    read1_slot.option[1] <- control.stack_r1_slot
    read1_slot.selected -> reg.general.r1_sel
    control.read_r2_sel -> reg.general.r2_sel
    control.read_x_sel -> reg.general.x_sel  // store 데이터 $X
    reg.general.r2_data -> control.r2_data
    reg.general.x_data -> control.x_data
    reg.general.r1_data -> control.r1_data

    // PRE 피연산자: NEG 계열의 Y와 즉치형의 Z는 unsigned byte를 64비트로 0 확장한 값.
    // 레지스터 피연산자는 Control이 POST·WB 값 전달까지 반영한 PRE 단계 값이다.
    arg1_mux.select[0] <- pre_decode.control.arg1_imm
    arg1_mux.select[1] <- pre_decode.control.arg1_zero
    arg1_mux.option[0] <- control.pre_value_r1
    arg1_mux.option[1] <- pre_decode.control.imm_y
    arg1_mux.option[2] <- 0
    arg1_mux.selected -> control.pre_arg1
    arg2_mux.select[0] <- pre_decode.control.arg2_imm
    arg2_mux.select[1] <- pre_decode.control.arg2_wyde
    arg2_mux.option[0] <- control.pre_value_r2
    arg2_mux.option[1] <- pre_decode.control.imm_z
    arg2_mux.option[2] <- pre_decode.control.imm_yz
    arg2_mux.selected -> control.pre_arg2
    store_data_mux.select <- pre_decode.control.store_constant
    store_data_mux.option[0] <- control.pre_value_x
    store_data_mux.option[1] <- pre_decode.control.imm_x
    store_data_mux.selected -> control.pre_store

    // EX 유효 주소
    address_add.a <- control.arg1
    address_add.b <- control.arg2
    address_add.c_in <- 0
    address_add.c_out -> OPENED
    address_add.sum -> control.effective_address
    // EX 결과는 Control이 POST를 거쳐 WB 단계로 넘겨 쓴다. load 값은 WB에서 메모리 응답을 쓴다.
    ex_value_mux.select <- control.address_write_en
    ex_value_mux.option[0] <- alu.res
    ex_value_mux.option[1] <- control.address_result
    ex_value_mux.selected -> control.ex_value
    control.wb_sel -> reg.general.w_sel
    control.wb_data -> reg.general.w_data
    control.wb_en -> reg.general.w_en

    // rD는 PRE가 DIVU 미지원 판정에 읽고, rM은 EX의 ALU가 읽는다. rA·rH·rR은 POST가 쓴다.
    reg.alu_direct.rD_in -> control.rD
    reg.alu_direct.rM_in -> alu.rM
    reg.alu_direct.rA_in -> control.ra_in
    control.ra_out -> reg.alu_direct.rA_out
    control.ra_w_en -> reg.alu_direct.rA_w_en
    control.rh_out -> reg.alu_direct.rH_out
    control.rh_w_en -> reg.alu_direct.rH_w_en
    control.rr_out -> reg.alu_direct.rR_out
    control.rr_w_en -> reg.alu_direct.rR_w_en

    control.fetch.req_valid -> fetch.control.req_valid
    control.fetch.req_pc -> fetch.control.req_pc
    fetch.control.req_ready -> control.fetch.req_ready
    fetch.control.res_valid -> control.fetch.res_valid
    control.fetch.res_ready -> fetch.control.res_ready
    fetch.control.res_pc -> control.fetch.res_pc
    fetch.control.instruction -> control.fetch.instruction
    fetch.control.error -> control.fetch.error
    control.fetch.flush -> fetch.control.flush
    fetch.control.busy -> control.fetch.busy

    // 데이터 메모리 접근은 POST가 요청한다. store 데이터 $X는 읽기 포트 x로 읽어 Control이 전달한 값이다.
    control.memory.req_valid -> memory.control.req_valid
    control.memory.address -> memory.control.address
    control.memory.store -> memory.control.store
    control.memory.size -> memory.control.size
    control.memory.zero_extend -> memory.control.zero_extend
    control.memory.write_data -> memory.control.write_data
    control.memory.line -> memory.control.line
    control.memory.line_mask -> memory.control.line_mask
    control.memory.line_write_data -> memory.control.line_write_data
    memory.control.line_read_data -> control.memory.line_read_data
    control.memory.res_ready -> memory.control.res_ready
    memory.control.req_ready -> control.memory.req_ready
    memory.control.res_valid -> control.memory.res_valid
    memory.control.read_data -> control.memory.read_data
    memory.control.error -> control.memory.error
    fetch.axi.arid -> read_select.instruction.arid
    memory.axi.read.arid -> read_select.data.arid
    read_select.bus.arid -> axi.read.arid
    fetch.axi.araddr -> read_select.instruction.araddr
    memory.axi.read.araddr -> read_select.data.araddr
    read_select.bus.araddr -> axi.read.araddr
    fetch.axi.arlen -> read_select.instruction.arlen
    memory.axi.read.arlen -> read_select.data.arlen
    read_select.bus.arlen -> axi.read.arlen
    fetch.axi.arsize -> read_select.instruction.arsize
    memory.axi.read.arsize -> read_select.data.arsize
    read_select.bus.arsize -> axi.read.arsize
    fetch.axi.arburst -> read_select.instruction.arburst
    memory.axi.read.arburst -> read_select.data.arburst
    read_select.bus.arburst -> axi.read.arburst
    fetch.axi.arlock -> read_select.instruction.arlock
    memory.axi.read.arlock -> read_select.data.arlock
    read_select.bus.arlock -> axi.read.arlock
    fetch.axi.arcache -> read_select.instruction.arcache
    memory.axi.read.arcache -> read_select.data.arcache
    read_select.bus.arcache -> axi.read.arcache
    fetch.axi.arprot -> read_select.instruction.arprot
    memory.axi.read.arprot -> read_select.data.arprot
    read_select.bus.arprot -> axi.read.arprot
    fetch.axi.arqos -> read_select.instruction.arqos
    memory.axi.read.arqos -> read_select.data.arqos
    read_select.bus.arqos -> axi.read.arqos
    fetch.axi.arvalid -> read_select.instruction.arvalid
    memory.axi.read.arvalid -> read_select.data.arvalid
    read_select.bus.arvalid -> axi.read.arvalid
    fetch.axi.rready -> read_select.instruction.rready
    memory.axi.read.rready -> read_select.data.rready
    read_select.bus.rready -> axi.read.rready
    axi.read.arready -> read_select.bus.arready
    read_select.instruction.arready -> fetch.axi.arready
    read_select.data.arready -> memory.axi.read.arready
    axi.read.rid -> read_select.bus.rid
    read_select.instruction.rid -> fetch.axi.rid
    read_select.data.rid -> memory.axi.read.rid
    axi.read.rdata -> read_select.bus.rdata
    read_select.instruction.rdata -> fetch.axi.rdata
    read_select.data.rdata -> memory.axi.read.rdata
    axi.read.rresp -> read_select.bus.rresp
    read_select.instruction.rresp -> fetch.axi.rresp
    read_select.data.rresp -> memory.axi.read.rresp
    axi.read.rlast -> read_select.bus.rlast
    read_select.instruction.rlast -> fetch.axi.rlast
    read_select.data.rlast -> memory.axi.read.rlast
    axi.read.rvalid -> read_select.bus.rvalid
    read_select.instruction.rvalid -> fetch.axi.rvalid
    read_select.data.rvalid -> memory.axi.read.rvalid
    memory.axi.write.awid -> axi.write.awid
    memory.axi.write.awaddr -> axi.write.awaddr
    memory.axi.write.awlen -> axi.write.awlen
    memory.axi.write.awsize -> axi.write.awsize
    memory.axi.write.awburst -> axi.write.awburst
    memory.axi.write.awlock -> axi.write.awlock
    memory.axi.write.awcache -> axi.write.awcache
    memory.axi.write.awprot -> axi.write.awprot
    memory.axi.write.awqos -> axi.write.awqos
    memory.axi.write.awvalid -> axi.write.awvalid
    memory.axi.write.wdata -> axi.write.wdata
    memory.axi.write.wstrb -> axi.write.wstrb
    memory.axi.write.wlast -> axi.write.wlast
    memory.axi.write.wvalid -> axi.write.wvalid
    memory.axi.write.bready -> axi.write.bready
    axi.write.awready -> memory.axi.write.awready
    axi.write.wready -> memory.axi.write.wready
    axi.write.bid -> memory.axi.write.bid
    axi.write.bresp -> memory.axi.write.bresp
    axi.write.bvalid -> memory.axi.write.bvalid
}
