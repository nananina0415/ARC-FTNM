// 레지스터 스택과 TRAP의 여러 클록 동작을 수행한다. StackRequired가 판정한 명령이 POST에서
// 단독 실행될 때 start=1인 에지부터 이 FSM이 진행한다.
// retry: 같은 명령을 다시 실행, retire: 명령 완료, access_fault: 정지.
// 로컬 ring은 슬롯 0..255(크기 256), 글로벌 $k는 슬롯 256+k다(reg/stack.pseudo).
// alpha = rO[3..11], gamma = rS[3..11]이며 8비트 덧셈이 그대로 mod 256이다.
seq StackControl {
    pub clock: In<bit,1>
    pub reset: In<bit,1>
    pub start: In<bit,1>
    pub writes_x: In<bit,1>
    pub push: In<bit,1>
    pub pop: In<bit,1>
    pub put_g: In<bit,1>
    pub put_l: In<bit,1>  // PUT rL 완료 에지. 여러 클록이 필요 없다
    pub save: In<bit,1>
    pub unsave: In<bit,1>
    pub trap: In<bit,1>
    pub rJ: WordIn
    pub pc_next: WordIn  // TRAP의 rWW
    pub instruction: In<bit,32>  // TRAP의 rXX
    pub x: In<bit,8>
    pub value: WordIn  // PUT 값, UNSAVE의 $Z
    pub r1_data: WordIn
    pub r1_valid: In<bit,1>  // r1_data가 지금 슬롯의 최신 값이면 1 (레지스터는 블록 RAM 동기 읽기)
    pub special_valid: In<bit,1>  // special_data가 지금 번호의 최신 값이면 1

    pub rG: In<bit,8>
    pub rL: In<bit,8>
    pub rO: WordIn
    pub rS: WordIn
    pub rG_in: Out<bit,8>
    pub rG_w_en: Out<bit,1>
    pub rL_in: Out<bit,8>
    pub rL_w_en: Out<bit,1>
    pub rO_in: WordOut
    pub rO_w_en: Out<bit,1>
    pub rS_in: WordOut
    pub rS_w_en: Out<bit,1>

    pub retry: Out<bit,1>
    pub retire: Out<bit,1>
    pub push_retire: Out<bit,1>
    pub save_write: Out<bit,1>  // SAVE 완료 에지. $X에 save_address를 쓴다
    pub save_address: WordOut
    pub access_fault: Out<bit,1>

    pub r1_physical: Out<bit,1>
    pub r1_slot: Out<bit,9>
    pub w_en: Out<bit,1>
    pub w_slot: Out<bit,9>
    pub w_data: WordOut

    // SAVE/UNSAVE가 특수 레지스터를 옮길 때 쓰는 GET/PUT 버스 제어
    pub special_en: Out<bit,1>
    pub special_write: Out<bit,1>
    pub special_sel: Out<bit,5>
    pub special_data: WordIn
    pub special_value: WordOut

    pub mem_valid: Out<bit,1>
    pub mem_store: Out<bit,1>
    pub mem_write_data: WordOut
    pub mem_ready: In<bit,1>
    pub mem_res_valid: In<bit,1>
    pub mem_res_ready: Out<bit,1>
    pub mem_read_data: WordIn
    pub mem_error: In<bit,1>
    // spill/fill은 32바이트 라인 안의 연속 칸을 한 번에 옮긴다(memory::MemoryIO의 line 경로).
    pub mem_line: Out<bit,1>
    pub mem_line_mask: Out<bit,4>
    pub mem_line_data: Out<bit,256>
    pub mem_line_read: In<bit,256>

    mut state: reg::ValueReg<5>
    mut y: reg::ValueReg<WORD_SIZE>  // POP이 hole로 옮길 값
    mut k: reg::ValueReg<8>  // hole이 기록한 PUSH 칸 수 - 1
    mut index: reg::ValueReg<8>  // SAVE/UNSAVE가 옮기는 레지스터 번호, UNSAVE의 남은 로컬 수
    mut phase: reg::ValueReg<2>  // 0: 글로벌, 1: 특수 레지스터, 2: (rG,rA)
    mut gather: reg::ValueReg<3>  // spill에서 모은 칸 수, fill에서 ring에 쓴 칸 수
    mut fill_count: reg::ValueReg<3>  // 이번 fill이 가져오는 칸 수
    mut words: [reg::ValueReg<WORD_SIZE>; 4]  // spill로 내보낼 라인의 octa
    mut save_word: reg::ValueReg<WORD_SIZE>  // SAVE가 저장할 값. 받아 둔 다음 클록에 요청한다
    mut save_armed: reg::ValueReg<1>  // save_word에 이번 칸의 값이 있다
    sel: Decoder<5,32>

    x_vs_g: Adder<8>
    x_vs_l: Adder<8>
    l_vs_x: Adder<8>
    value_vs_g: Adder<8>
    value_vs_l: Adder<8>
    pending: Adder<9>  // (rO-rS)/8. rS가 잠시 rO를 넘는 경우까지 구분한다
    fill_level: Adder<8>
    hole_vs_pending: Adder<9>

    // 묶음 크기. p = (rS/8) mod 4는 rS가 라인 안에서 몇 번째 octa인지다.
    to_boundary: Adder<3>  // 4 - p: rS부터 라인 끝까지 칸 수
    pending_cap: Mux<2,3>  // min(pending, 4)
    spill_cmp: Adder<3>
    spill_count: Mux<2,3>  // min(pending, 4 - p)
    spill_end: Adder<3>  // p + spill_count
    fill_bound: Mux<2,3>  // 라인 시작부터 rS 앞까지 칸 수: p, p=0이면 4
    free_slots: Adder<8>  // -(pending + L) mod 256: ring 빈칸 수
    free_cap: Mux<3,3>  // min(빈칸, 4). pending+L=0이면 4, ring이 가득이면 1
    fill_cmp: Adder<3>
    fill_min: Mux<2,3>
    fill_source: Mux<2,3>  // UNSAVE는 1칸씩
    gather_step: Adder<3>
    gather_next: Mux<2,3>
    gather_ring: Adder<8>  // gamma + gather
    lane: Adder<2>  // (p + gather) mod 4: 라인 안 octa 위치
    lane_select: Decoder<2,4>
    line_word: Mux<4,WORD_SIZE>
    s_amount: Mux<3,3>  // rS를 옮길 칸 수

    minus_one_source: Mux<4,8>
    minus_one: Adder<8>
    offset: Mux<3,8>
    ring_add: Adder<8>
    slot: Mux<4,8>
    data: Mux<6,WORD_SIZE>
    y_source: Mux<2,WORD_SIZE>

    increment_source: Mux<2,8>
    increment: Adder<8>
    count: Mux<2,8>
    l_increment: Adder<8>
    l_subtract: Adder<8>

    pop_x: Mux<2,8>
    pop_sum: Adder<8>
    pop_vs_g: Adder<8>
    pop_l: Mux<2,8>
    k_vs_l: Adder<8>

    l_source: Mux<4,8>
    g_load: Mux<2,8>
    g_source: Mux<3,8>
    o_count: Mux<2,8>
    o_add: Adder<WORD_SIZE>
    o_source: Mux<2,WORD_SIZE>
    s_base: Mux<2,WORD_SIZE>
    s_add: Adder<WORD_SIZE>

    index_step: Adder<8>
    index_source: Mux<7,8>
    index_vs_g: Adder<8>
    store_source: Mux<3,WORD_SIZE>
    special_index: Mux<3,5>
    trap_register: Mux<7,5>
    special_source: Mux<6,WORD_SIZE>
}

wire StackControl {
    alias {
        IDLE=0
        GROW=1
        CHECK=2
        SPILL_REQUEST=3
        SPILL_WAIT=4
        POP_READ=5
        POP_BASE=6
        FILL_ADDRESS=7
        FILL_REQUEST=8
        FILL_WAIT=9
        POP_HOLE=10
        POP_COMMIT=11
        PUSH_COMMIT=12
        G_CLEAR=13
        G_COMMIT=15
        SAVE_HOLE=16
        SAVE_FLUSH=17
        SAVE_REQUEST=18
        SAVE_WAIT=19
        SAVE_COMMIT=20
        UNSAVE_BASE=21
        UNSAVE_ADDRESS=22
        UNSAVE_REQUEST=23
        UNSAVE_WAIT=24
        UNSAVE_HOLE=25
        UNSAVE_LOCALS=26
        UNSAVE_COMMIT=27
        TRAP_STEP=28
        SPILL_GATHER=29
    }
    alias idle = sel.out[IDLE]
    alias grow = sel.out[GROW]
    alias check = sel.out[CHECK]
    alias spill_request = sel.out[SPILL_REQUEST]
    alias spill_wait = sel.out[SPILL_WAIT]
    alias pop_read = sel.out[POP_READ]
    alias pop_base = sel.out[POP_BASE]
    alias fill_address = sel.out[FILL_ADDRESS]
    alias fill_request = sel.out[FILL_REQUEST]
    alias fill_wait = sel.out[FILL_WAIT]
    alias pop_hole = sel.out[POP_HOLE]
    alias pop_commit = sel.out[POP_COMMIT]
    alias push_commit = sel.out[PUSH_COMMIT]
    alias g_clear = sel.out[G_CLEAR]
    alias g_commit = sel.out[G_COMMIT]
    alias save_hole = sel.out[SAVE_HOLE]
    alias save_flush = sel.out[SAVE_FLUSH]
    alias save_request = sel.out[SAVE_REQUEST]
    alias save_wait = sel.out[SAVE_WAIT]
    alias save_commit = sel.out[SAVE_COMMIT]
    alias unsave_base = sel.out[UNSAVE_BASE]
    alias unsave_address = sel.out[UNSAVE_ADDRESS]
    alias unsave_request = sel.out[UNSAVE_REQUEST]
    alias unsave_wait = sel.out[UNSAVE_WAIT]
    alias unsave_hole = sel.out[UNSAVE_HOLE]
    alias unsave_locals = sel.out[UNSAVE_LOCALS]
    alias unsave_commit = sel.out[UNSAVE_COMMIT]
    alias trap_step = sel.out[TRAP_STEP]
    alias spill_gather = sel.out[SPILL_GATHER]
    sel.out[14] -> OPENED
    sel.out[30..32] -> OPENED

    // TRAP 단계: 0 rWW, 1 rXX, 2 rYY, 3 rZZ, 4 rBB, 5 $255, 6 rK와 PC.
    alias step0 = and(trap_step, not(index.out[0]), not(index.out[1]), not(index.out[2]))
    alias step1 = and(trap_step, index.out[0], not(index.out[1]), not(index.out[2]))
    alias step2 = and(trap_step, not(index.out[0]), index.out[1], not(index.out[2]))
    alias step3 = and(trap_step, index.out[0], index.out[1], not(index.out[2]))
    alias step4 = and(trap_step, not(index.out[0]), not(index.out[1]), index.out[2])
    alias step5 = and(trap_step, index.out[0], not(index.out[1]), index.out[2])
    alias step6 = and(trap_step, not(index.out[0]), index.out[1], index.out[2])

    alias x_global = x_vs_g.c_out
    alias x_local = not(x_vs_l.c_out)
    alias need_grow = and(writes_x, not(x_global), not(x_local))
    alias push_global = and(push, x_global)
    alias hole_path = or(push_global, save)  // L을 한 칸 늘린 뒤 그 칸에 hole을 쓴다
    alias hole_commit = or(push_commit, save_hole)

    alias g_above = not(value_vs_g.c_out)
    alias value_below_l = and(not(or(value[8..WORD_SIZE])), not(value_vs_l.c_out))

    alias pending_zero = not(or(pending.sum[0..9]))
    // L <= G <= 255이므로 L, hole의 k, POP·UNSAVE의 새 L은 ring(256칸)을 넘지 않는다.
    alias ring_full = not(or(fill_level.sum[0..8]))
    alias hole_needs_fill = hole_vs_pending.c_out  // 미저장 칸 수 <= k
    alias x_at_most_l = l_vs_x.c_out
    alias pop_writes_hole = not(k_vs_l.c_out)
    alias res_ok = and(mem_res_valid, not(mem_error))
    alias l_nonzero = or(rL[0..8])

    alias phase_global = not(or(phase.out[0..2]))
    alias phase_special = phase.out[0]
    alias phase_pack = phase.out[1]
    alias index_max = and(index.out[0..8])
    alias index_zero = not(or(index.out[0..8]))
    alias index_6 = and(not(index.out[0]), index.out[1], index.out[2], not(or(index.out[3..8])))
    alias index_23 = and(index.out[0], index.out[1], index.out[2], not(index.out[3]), index.out[4], not(or(index.out[5..8])))
    alias index_27 = and(index.out[0], index.out[1], not(index.out[2]), index.out[3], index.out[4], not(or(index.out[5..8])))
    alias index_at_g = not(or(index_vs_g.sum[0..8]))
    alias save_done = and(save_wait, res_ok)
    alias unsave_done = and(unsave_wait, res_ok)
    alias slot_is_index = and(phase_global, or(save_request, unsave_wait))

    clock => { state.clock, y.clock, k.clock, index.clock, phase.clock, gather.clock, fill_count.clock, words[0..4].clock, save_word.clock, save_armed.clock }
    reset => { state.reset, y.reset, k.reset, index.reset, phase.reset, gather.reset, fill_count.reset, words[0..4].reset, save_word.reset, save_armed.reset }

    // 번호 비교
    x -> x_vs_g.a
    x_vs_g.b <- not(rG)
    x_vs_g.c_in <- 1
    x_vs_g.sum -> OPENED
    x -> x_vs_l.a
    x_vs_l.b <- not(rL)
    x_vs_l.c_in <- 1
    x_vs_l.sum -> OPENED
    rL -> l_vs_x.a
    l_vs_x.b <- not(x)
    l_vs_x.c_in <- 1
    l_vs_x.sum -> OPENED
    value_vs_g.a <- [ value[0..8] ]
    value_vs_g.b <- not(rG)
    value_vs_g.c_in <- 1
    value_vs_g.sum -> OPENED
    value_vs_l.a <- [ value[0..8] ]
    value_vs_l.b <- not(rL)
    value_vs_l.c_in <- 1
    value_vs_l.sum -> OPENED
    index.out -> index_vs_g.a
    index_vs_g.b <- not(rG)
    index_vs_g.c_in <- 1
    index_vs_g.c_out -> OPENED

    // ring에 있고 메모리에는 없는 칸 수
    pending.a <- [ rO[3..12] ]
    pending.b <- not([ rS[3..12] ])
    pending.c_in <- 1
    pending.c_out -> OPENED
    fill_level.a <- [ pending.sum[0..8] ]
    fill_level.b <- rL
    fill_level.c_in <- 0
    fill_level.c_out -> OPENED
    hole_vs_pending.a[0..8] <- [ r1_data[0..8] ]
    hole_vs_pending.a[8] <- 0
    hole_vs_pending.b <- not(pending.sum)
    hole_vs_pending.c_in <- 1
    hole_vs_pending.sum -> OPENED

    // spill 칸 수 = min(pending, 4 - p). rS가 정렬돼 있고 pending이 4 이상이면 4칸이다.
    { to_boundary.a[0,1] } <= 0
    to_boundary.a[2] <- 1
    to_boundary.b[0..2] <- not([ rS[3..5] ])
    to_boundary.b[2] <- 1
    to_boundary.c_in <- 1
    to_boundary.c_out -> OPENED
    pending_cap.select <- or(pending.sum[2..9])
    pending_cap.option[0][0..2] <- [ pending.sum[0..2] ]
    pending_cap.option[0][2] <- 0
    pending_cap.option[1] <- 4
    spill_cmp.a <- pending_cap.selected
    spill_cmp.b <- not(to_boundary.sum)
    spill_cmp.c_in <- 1
    spill_cmp.sum -> OPENED
    spill_count.select <- spill_cmp.c_out
    spill_count.option[0] <- pending_cap.selected
    spill_count.option[1] <- to_boundary.sum
    spill_end.a[0..2] <- [ rS[3..5] ]
    spill_end.a[2] <- 0
    spill_end.b <- spill_count.selected
    spill_end.c_in <- 0
    spill_end.c_out -> OPENED

    // fill 칸 수 = min(fill_bound, 빈칸). UNSAVE는 1칸.
    fill_bound.select <- not(or(rS[3], rS[4]))
    fill_bound.option[0][0..2] <- [ rS[3..5] ]
    fill_bound.option[0][2] <- 0
    fill_bound.option[1] <- 4
    free_slots.a <- not(fill_level.sum)
    free_slots.b <- 0
    free_slots.c_in <- 1
    free_slots.c_out -> OPENED
    // pending+L이 256이면 8비트로 0이 되므로 비어 있는지는 두 값을 직접 본다.
    alias fill_level_zero = and(pending_zero, not(l_nonzero))
    alias free_big = or(free_slots.sum[2..8])
    free_cap.select[0] <- or(free_big, fill_level_zero)
    free_cap.select[1] <- and(ring_full, not(fill_level_zero))
    free_cap.option[0][0..2] <- [ free_slots.sum[0..2] ]
    free_cap.option[0][2] <- 0
    free_cap.option[1] <- 4
    free_cap.option[2] <- 1
    fill_cmp.a <- free_cap.selected
    fill_cmp.b <- not(fill_bound.selected)
    fill_cmp.c_in <- 1
    fill_cmp.sum -> OPENED
    fill_min.select <- fill_cmp.c_out
    fill_min.option[0] <- free_cap.selected
    fill_min.option[1] <- fill_bound.selected
    fill_source.select <- unsave
    fill_source.option[0] <- fill_min.selected
    fill_source.option[1] <- 1
    fill_count.w_en <- fill_address
    fill_source.selected -> fill_count.in

    // gather: spill은 모은 칸 수, fill은 ring에 쓴 칸 수. 그 밖에는 0이다.
    gather_step.a <- gather.out
    gather_step.b <- 0
    gather_step.c_in <- 1
    gather_step.c_out -> OPENED
    alias spill_last = not(or(
        xor(gather_step.sum[0], spill_count.selected[0]),
        xor(gather_step.sum[1], spill_count.selected[1]),
        xor(gather_step.sum[2], spill_count.selected[2]),
    ))
    alias fill_last = not(or(
        xor(gather_step.sum[0], fill_count.out[0]),
        xor(gather_step.sum[1], fill_count.out[1]),
        xor(gather_step.sum[2], fill_count.out[2]),
    ))
    gather_next.select <- or(and(spill_gather, r1_valid, not(spill_last)), and(fill_wait, res_ok, not(fill_last)))
    gather_next.option[0] <- 0
    gather_next.option[1] <- gather_step.sum
    gather.w_en <- 1
    gather_next.selected -> gather.in
    gather_ring.a <- [ rS[3..11] ]
    gather_ring.b[0..3] <- gather.out
    { gather_ring.b[3..8] } <= 0
    gather_ring.c_in <- 0
    gather_ring.c_out -> OPENED

    // 라인 안 octa 위치. spill은 모은 값을 그 위치에 두고, fill은 그 위치의 값을 ring에 쓴다.
    lane.a <- [ rS[3..5] ]
    lane.b <- [ gather.out[0..2] ]
    lane.c_in <- 0
    lane.c_out -> OPENED
    lane.sum -> lane_select.in
    words[0].w_en <- and(spill_gather, r1_valid, lane_select.out[0])
    words[1].w_en <- and(spill_gather, r1_valid, lane_select.out[1])
    words[2].w_en <- and(spill_gather, r1_valid, lane_select.out[2])
    words[3].w_en <- and(spill_gather, r1_valid, lane_select.out[3])
    r1_data => { words[0..4].in }
    mem_line_data[0..64] <- words[0].out
    mem_line_data[64..128] <- words[1].out
    mem_line_data[128..192] <- words[2].out
    mem_line_data[192..256] <- words[3].out
    line_word.select <- lane.sum
    line_word.option[0] <- mem_line_read[0..64]
    line_word.option[1] <- mem_line_read[64..128]
    line_word.option[2] <- mem_line_read[128..192]
    line_word.option[3] <- mem_line_read[192..256]

    // 쓰기 마스크: 라인 안 위치 p .. p+spill_count-1
    alias end0 = spill_end.sum[0]
    alias end1 = spill_end.sum[1]
    alias end2 = spill_end.sum[2]
    mem_line_mask[0] <- or(end0, end1, end2)
    mem_line_mask[1] <- and(or(rS[3], rS[4]), or(end1, end2))
    mem_line_mask[2] <- and(rS[4], or(end2, and(end0, end1)))
    mem_line_mask[3] <- and(rS[3], rS[4], end2)

    // 다음 상태
    alias enter = and(idle, start)
    alias next_grow = and(enter, or(need_grow, hole_path))
    alias next_check = grow
    alias next_spill_gather = or(
        and(check, ring_full),
        and(save_flush, not(pending_zero)),
        and(spill_gather, or(not(r1_valid), not(spill_last))),
    )
    alias next_spill_request = or(and(spill_gather, r1_valid, spill_last), and(spill_request, not(mem_ready)))
    alias next_spill_wait = or(and(spill_request, mem_ready), and(spill_wait, not(mem_res_valid)))
    alias next_pop_read = or(and(enter, not(need_grow), pop), and(pop_read, not(r1_valid)))
    alias next_pop_base = and(pop_read, r1_valid)
    alias next_fill_address = or(
        and(pop_base, pending_zero),
        and(pop_hole, r1_valid, hole_needs_fill),
        and(unsave_done, phase_global, index_at_g),
        and(unsave_locals, not(index_zero)),
    )
    alias next_fill_request = or(fill_address, and(fill_request, not(mem_ready)))
    // FILL_WAIT는 응답 라인을 붙잡은 채 한 클록에 한 칸씩 ring에 쓴다.
    alias fill_done = and(fill_wait, res_ok, fill_last)
    alias next_fill_wait = or(and(fill_request, mem_ready), and(fill_wait, not(mem_res_valid)), and(fill_wait, res_ok, not(fill_last)))
    alias next_pop_hole = or(and(pop_base, not(pending_zero)), and(fill_done, not(unsave)), and(pop_hole, not(r1_valid)))
    alias next_pop_commit = and(pop_hole, r1_valid, not(hole_needs_fill))
    alias next_push_commit = or(
        and(enter, not(need_grow), push, not(push_global)),
        and(check, not(ring_full), push_global),
        and(spill_wait, res_ok, push_global),
    )
    // PUT rG는 ring 크기를 바꾸지 않으므로 spill 없이 새로 글로벌이 된 칸만 0으로 만든다.
    alias next_g_clear = or(and(enter, put_g), and(g_clear, g_above))
    alias next_g_commit = and(g_clear, not(g_above))
    alias next_save_hole = or(and(check, not(ring_full), save), and(spill_wait, res_ok, save, l_nonzero))
    alias next_save_flush = or(save_hole, and(spill_wait, res_ok, save, not(l_nonzero)))
    // 저장할 값(글로벌은 읽기 포트 1, 특수 레지스터는 버스)이 최신일 때만 요청한다.
    alias save_ready = or(and(phase_global, r1_valid), and(phase_special, special_valid), phase_pack)
    alias next_save_request = or(
        and(save_flush, pending_zero),
        and(save_request, not(and(save_armed.out, mem_ready))),
        and(save_done, not(phase_pack)),
    )
    alias next_save_wait = or(and(save_request, save_armed.out, mem_ready), and(save_wait, not(mem_res_valid)))
    alias next_save_commit = and(save_done, phase_pack)
    alias next_unsave_base = and(enter, unsave)
    alias next_unsave_address = or(unsave_base, and(unsave_done, not(and(phase_global, index_at_g))))
    alias next_unsave_request = or(unsave_address, and(unsave_request, not(mem_ready)))
    alias next_unsave_wait = or(and(unsave_request, mem_ready), and(unsave_wait, not(mem_res_valid)))
    alias next_unsave_hole = or(and(fill_done, unsave, phase_global), and(unsave_hole, not(r1_valid)))
    alias next_unsave_locals = or(and(unsave_hole, r1_valid), and(fill_done, unsave, not(phase_global)))
    alias next_unsave_commit = and(unsave_locals, index_zero)
    alias trap_enter = and(enter, trap)
    alias next_trap_step = or(trap_enter, and(trap_step, not(step6)))

    state.w_en <- 1
    state.out -> sel.in
    state.in[0] <- or(next_grow, next_spill_request, next_pop_read, next_fill_address, next_fill_wait, next_pop_commit, next_g_clear, next_g_commit, next_save_flush, next_save_wait, next_unsave_base, next_unsave_request, next_unsave_hole, next_unsave_commit, next_spill_gather)
    state.in[1] <- or(next_check, next_spill_request, next_pop_base, next_fill_address, next_pop_hole, next_pop_commit, next_g_commit, next_save_request, next_save_wait, next_unsave_address, next_unsave_request, next_unsave_locals, next_unsave_commit)
    state.in[2] <- or(next_spill_wait, next_pop_read, next_pop_base, next_fill_address, next_push_commit, next_g_clear, next_g_commit, next_save_commit, next_unsave_base, next_unsave_address, next_unsave_request, next_trap_step, next_spill_gather)
    state.in[3] <- or(next_fill_request, next_fill_wait, next_pop_hole, next_pop_commit, next_push_commit, next_g_clear, next_g_commit, next_unsave_wait, next_unsave_hole, next_unsave_locals, next_unsave_commit, next_trap_step, next_spill_gather)
    state.in[4] <- or(next_save_hole, next_save_flush, next_save_request, next_save_wait, next_save_commit, next_unsave_base, next_unsave_address, next_unsave_request, next_unsave_wait, next_unsave_hole, next_unsave_locals, next_unsave_commit, next_trap_step, next_spill_gather)

    retry <- or(and(check, not(ring_full), not(hole_path)), and(spill_wait, res_ok, not(hole_path)))
    retire <- or(push_commit, pop_commit, g_commit, save_commit, unsave_commit, step6)
    push_commit -> push_retire
    save_commit -> save_write
    access_fault <- and(or(spill_wait, fill_wait, save_wait, unsave_wait), mem_res_valid, mem_error)

    // 슬롯 계산. minus_one은 hole 위치(-1), X-1, L-1, G-1을 만든다.
    minus_one_source.select[0] <- or(pop_read, g_clear)
    minus_one_source.select[1] <- or(and(push_commit, push_global), save_hole, g_clear)
    minus_one_source.option[0] <- 0
    minus_one_source.option[1] <- x
    minus_one_source.option[2] <- rL
    minus_one_source.option[3] <- rG
    minus_one_source.selected -> minus_one.a
    { minus_one.b[0..8] } <= 1
    minus_one.c_in <- 0
    minus_one.c_out -> OPENED

    offset.select[0] <- and(push_commit, not(push_global))
    offset.select[1] <- or(pop_read, pop_hole, pop_commit, and(push_commit, push_global), save_hole)
    offset.option[0] <- rL
    offset.option[1] <- x
    offset.option[2] <- minus_one.sum
    ring_add.a <- [ rO[3..11] ]
    offset.selected -> ring_add.b
    ring_add.c_in <- 0
    ring_add.c_out -> OPENED

    // 0: ring, 1: gamma+gather, 2: minus_one(G-1, TRAP에서는 0-1=255), 3: index(글로벌 번호)
    // 0, 1은 로컬 슬롯 {0, 값}, 2, 3은 글로벌 슬롯 {1, 번호}다.
    alias slot_global = or(g_clear, slot_is_index, trap_step)
    slot.select[0] <- or(spill_gather, fill_wait, unsave_hole, slot_is_index)
    slot.select[1] <- slot_global
    slot.option[0] <- ring_add.sum
    slot.option[1] <- gather_ring.sum
    slot.option[2] <- minus_one.sum
    slot.option[3] <- index.out
    r1_slot[0..8] <- slot.selected
    r1_slot[8] <- slot_global
    w_slot[0..8] <- slot.selected
    w_slot[8] <- slot_global
    r1_physical <- or(spill_gather, pop_read, pop_hole, unsave_hole, and(save_request, phase_global), step4)

    // 내부 쓰기: GROW/G_CLEAR는 0, PUSH/SAVE는 hole 값, POP은 y, FILL은 라인의 octa, UNSAVE는 메모리 값, TRAP은 rJ.
    w_en <- or(
        grow,
        hole_commit,
        and(pop_commit, pop_writes_hole),
        and(fill_wait, res_ok),
        and(g_clear, g_above),
        and(unsave_done, phase_global),
        step5,
    )
    data.select[0] <- or(hole_commit, fill_wait, unsave_wait)
    data.select[1] <- or(pop_commit, unsave_wait)
    data.select[2] <- or(trap_step, fill_wait)
    rJ -> data.option[4]
    data.option[0] <- 0
    data.option[1][0..8] <- offset.selected
    { data.option[1][8..WORD_SIZE] } <= 0
    y.out -> data.option[2]
    mem_read_data -> data.option[3]
    line_word.selected -> data.option[5]
    data.selected -> w_data

    // POP 값과 hole 내용
    y_source.select <- and(or(x[0..8]), x_at_most_l)
    y_source.option[0] <- 0
    y_source.option[1] <- r1_data
    y.w_en <- and(pop_read, r1_valid)
    y_source.selected -> y.in
    k.w_en <- and(or(pop_hole, unsave_hole), r1_valid)
    k.in <- [ r1_data[0..8] ]

    // PUSH: 칸 수 = X+1 또는 L. SAVE: L. POP: k+1.
    increment_source.select <- pop
    increment_source.option[0] <- x
    increment_source.option[1] <- k.out
    increment_source.selected -> increment.a
    increment.b <- 0
    increment.c_in <- 1
    increment.c_out -> OPENED
    count.select <- hole_path
    count.option[0] <- increment.sum
    count.option[1] <- rL

    l_increment.a <- rL
    l_increment.b <- 0
    l_increment.c_in <- 1
    l_increment.c_out -> OPENED
    l_subtract.a <- rL
    l_subtract.b <- not(count.selected)
    l_subtract.c_in <- 1
    l_subtract.c_out -> OPENED

    // POP의 새 L = min(k + (X<=L ? X : L+1), G)
    pop_x.select <- x_at_most_l
    pop_x.option[0] <- l_increment.sum
    pop_x.option[1] <- x
    k.out -> pop_sum.a
    pop_x.selected -> pop_sum.b
    pop_sum.c_in <- 0
    pop_sum.sum -> pop_vs_g.a
    pop_vs_g.b <- not(rG)
    pop_vs_g.c_in <- 1
    pop_vs_g.sum -> OPENED
    pop_l.select <- or(pop_sum.c_out, pop_vs_g.c_out)
    pop_l.option[0] <- pop_sum.sum
    pop_l.option[1] <- rG
    k.out -> k_vs_l.a
    k_vs_l.b <- not(pop_l.selected)
    k_vs_l.c_in <- 1
    k_vs_l.sum -> OPENED

    // SAVE: 글로벌 G..255, 번호 0..6, 번호 23..27, (rG,rA) 순서로 저장한다.
    // UNSAVE: (rG,rA), 번호 27..23, 번호 6..0, 글로벌 255..G 순서로 읽는다.
    { index_step.b[0..8] } <= unsave
    index_step.a <- index.out
    index_step.c_in <- not(unsave)
    index_step.c_out -> OPENED
    alias index_to_g = and(save_flush, pending_zero)
    alias index_to_23 = and(save_done, phase_special, index_6)
    alias index_to_6 = and(unsave_done, phase_special, index_23)
    alias index_to_27 = and(unsave_done, phase_pack)
    index_source.select[0] <- or(index_to_g, index_to_6, unsave_hole)
    index_source.select[1] <- or(index_to_23, index_to_6, trap_enter)
    index_source.select[2] <- or(index_to_27, unsave_hole, trap_enter)
    index_source.option[6] <- 0
    index_source.option[0] <- index_step.sum
    index_source.option[1] <- rG
    index_source.option[2] <- 23
    index_source.option[3] <- 6
    index_source.option[4] <- 27
    index_source.option[5] <- [ r1_data[0..8] ]
    index_source.selected -> index.in
    index.w_en <- or(index_to_g, save_done, unsave_done, and(unsave_hole, r1_valid), and(unsave_locals, not(index_zero)), trap_enter, and(trap_step, trap_ready))

    phase.w_en <- or(
        index_to_g,
        and(save_done, phase_global, index_max),
        and(save_done, phase_special, index_27),
        unsave_base,
        index_to_27,
        and(unsave_done, phase_special, index_zero),
        and(unsave_hole, r1_valid),
    )
    phase.in[0] <- or(and(save_done, phase_global), index_to_27, unsave_hole)
    phase.in[1] <- or(and(save_done, phase_special), unsave_base)

    // SAVE 저장 데이터: 글로벌은 읽기 포트 1, 특수 레지스터는 버스, 마지막 칸은 (rG,rA).
    // spill 데이터는 mem_line_data(words)로 나간다.
    store_source.select[0] <- and(save_request, phase_special)
    store_source.select[1] <- and(save_request, phase_pack)
    store_source.option[0] <- r1_data
    store_source.option[1] <- special_data
    store_source.option[2][0..56] <- special_data[0..56]
    store_source.option[2][56..WORD_SIZE] <- rG
    // 값이 최신인 클록에 save_word에 받아 두고, 메모리 요청은 그 다음 클록부터 save_word로 한다.
    // 레지스터·특수 레지스터 읽기의 valid가 같은 클록의 메모리 요청으로 이어지지 않는다.
    alias save_arm = and(save_request, save_ready, not(save_armed.out))
    save_word.w_en <- save_arm
    store_source.selected -> save_word.in
    save_word.out -> mem_write_data
    save_armed.w_en <- 1
    save_armed.in <- and(save_request, or(save_armed.out, save_ready), not(and(save_armed.out, mem_ready)))

    special_index.select[0] <- and(phase_pack, not(trap_step))
    special_index.select[1] <- trap_step
    special_index.option[0] <- [ index.out[0..5] ]
    special_index.option[1] <- 21  // rA
    special_index.option[2] <- trap_register.selected
    special_index.selected -> special_sel
    trap_register.select <- [ index.out[0..3] ]
    trap_register.option[0] <- 28  // rWW
    trap_register.option[1] <- 29  // rXX
    trap_register.option[2] <- 30  // rYY
    trap_register.option[3] <- 31  // rZZ
    trap_register.option[4] <- 7   // rBB
    trap_register.option[5] <- 7   // 이 단계는 버스를 쓰지 않는다
    trap_register.option[6] <- 15  // rK
    // step2($Y)와 step4($255)는 읽기 포트 1의 값이 최신일 때만 진행한다.
    alias trap_ready = or(not(or(step2, step4)), r1_valid)
    alias trap_special = and(trap_step, not(step5), trap_ready)
    special_write <- or(and(unsave_done, not(phase_global)), trap_special)
    special_en <- or(and(save_request, not(phase_global)), and(unsave_done, not(phase_global)), trap_special)

    // 버스에 쓸 값. 0: UNSAVE의 메모리 값, 1~5: TRAP 단계별 값.
    special_source.select[0] <- or(step0, step2, step4, step6)
    special_source.select[1] <- or(step1, step2, step4)
    special_source.select[2] <- or(step3, step6)
    special_source.option[0] <- mem_read_data
    special_source.option[1] <- pc_next
    special_source.option[2][0..32] <- instruction
    { special_source.option[2][32..63] } <= 0
    special_source.option[2][63] <- 1
    special_source.option[3] <- r1_data  // step2: $Y, step4: $255
    special_source.option[4] <- value    // $Z
    special_source.option[5] <- 0
    special_source.selected -> special_value

    // 상태 레지스터 갱신
    // UNSAVE는 X=0(디코더가 확인)이므로 pop_l = min(k, G)이 된다.
    l_source.select[0] <- or(hole_commit, put_l)
    l_source.select[1] <- or(pop_commit, put_l, unsave_commit)
    l_source.option[0] <- l_increment.sum
    l_source.option[1] <- l_subtract.sum
    l_source.option[2] <- pop_l.selected
    l_source.option[3] <- [ value[0..8] ]
    l_source.selected -> rL_in
    rL_w_en <- or(grow, hole_commit, pop_commit, and(put_l, value_below_l), unsave_commit)

    // 저장된 G가 32보다 작으면 32로 복원한다.
    g_load.select <- or(mem_read_data[61..64])
    g_load.option[0] <- 32
    g_load.option[1] <- [ mem_read_data[56..64] ]
    g_source.select[0] <- g_commit
    g_source.select[1] <- unsave_wait
    g_source.option[0] <- minus_one.sum
    g_source.option[1] <- [ value[0..8] ]
    g_source.option[2] <- g_load.selected
    g_source.selected -> rG_in
    rG_w_en <- or(and(g_clear, g_above), g_commit, and(unsave_done, phase_pack))

    // rO에 8*칸 수를 더하거나 뺀다. SAVE/UNSAVE 완료에서는 rS와 같아진다.
    o_count.select <- pop
    o_count.option[0] <- count.selected
    o_count.option[1] <- not(count.selected)
    rO -> o_add.a
    { o_add.b[0..3] } <= pop
    o_add.b[3..11] <- o_count.selected
    { o_add.b[11..WORD_SIZE] } <= pop
    o_add.c_in <- pop
    o_add.c_out -> OPENED
    o_source.select <- or(save_commit, unsave_commit)
    o_source.option[0] <- o_add.sum
    o_source.option[1] <- rS
    o_source.selected -> rO_in
    rO_w_en <- or(hole_commit, pop_commit, save_commit, unsave_commit)

    // rS는 8 × 칸 수만큼 움직인다. spill/fill은 묶은 칸 수, 나머지는 1칸.
    // UNSAVE 시작에서는 정렬한 $Z + 8이 된다.
    alias s_down = or(fill_address, unsave_address, save_commit)
    s_amount.select[0] <- spill_wait
    s_amount.select[1] <- fill_address
    s_amount.option[0] <- 1
    s_amount.option[1] <- spill_count.selected
    s_amount.option[2] <- fill_source.selected
    s_base.select <- unsave_base
    s_base.option[0] <- rS
    { s_base.option[1][0..3] } <= 0
    s_base.option[1][3..WORD_SIZE] <- [ value[3..WORD_SIZE] ]
    s_base.selected -> s_add.a
    { s_add.b[0..3] } <= s_down
    s_add.b[3..6] <- xor(s_amount.selected, [ s_down, s_down, s_down ])
    { s_add.b[6..WORD_SIZE] } <= s_down
    s_add.c_in <- s_down
    s_add.c_out -> OPENED
    s_add.sum -> rS_in
    s_add.sum -> save_address
    rS_w_en <- or(and(spill_wait, res_ok), fill_address, save_done, unsave_base, unsave_address)

    mem_valid <- or(spill_request, fill_request, and(save_request, save_armed.out), unsave_request)
    mem_store <- or(spill_request, save_request)
    mem_line <- or(spill_request, fill_request)
    // fill은 마지막 칸을 쓸 때까지 응답 라인을 붙잡아 둔다.
    mem_res_ready <- and(or(spill_wait, and(fill_wait, or(fill_last, mem_error)), save_wait, unsave_wait), mem_res_valid)
}
