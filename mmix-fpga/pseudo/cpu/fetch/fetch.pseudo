// L1 I-cache: 한 라인에 명령어 8개, 32바이트 라인 8개. 요청은 한 번에 하나.
// valid && ready인 클록 상승 에지에서 요청/응답 전달.
// PC 하위 2비트는 명령어 위치 선택에 쓰지 않는다(MMIX: GO 목표의 하위 2비트는 무시되고 PC에만 남는다).
// 응답은 제어유닛이 받을 때까지 유지. error=1이면 instruction 실행 금지.
// PC 갱신(+4/분기)과 예외 처리는 제어유닛 담당.
// 분기로 불필요해진 응답도 받아 버린 뒤 다음 주소를 요청.

bundle FetchIO {  // Fetch 입장
    req_valid: In<bit,1>
    req_ready: Out<bit,1>
    req_pc:    WordIn

    res_valid: Out<bit,1>
    res_ready: In<bit,1>
    res_pc:    WordOut
    instruction: Out<bit,32>
    error:     Out<bit,1>  // 30비트 주소 범위 오류 또는 AXI 읽기 오류
}

seq Fetch {
    pub clock: In<bit,1>
    pub reset: In<bit,1>  // 동기 active-high. RAM AXI 측도 같은 reset 경계 사용
    pub ram_ready: In<bit,1>  // MIG.init_calib_complete. 새 요청만 차단, 진행 중 요청은 유지
    pub invalidate: In<bit,1>  // store 완료 시 보수적으로 I-cache 전체 무효화
    pub control: FetchIO
    pub axi: AxiRead

    mut pc:          FetchReg<WORD_SIZE>
    mut addr_wait:   FetchReg<1>
    mut data_wait:   FetchReg<1>
    mut output_full: FetchReg<1>
    mut bus_error:   FetchReg<1>
    mut instruction: FetchReg<32>
    mut error:       FetchReg<1>

    tetra_mux: Mux<8,32>
    instruction_mux: Mux<2,32>
    error_mux: Mux<2,1>
    mut cache: cache::LineCache8
    line_source: Mux<2,256>
    tetra_index: Mux<2,3>
}

wire Fetch {
    alias active = not(reset)
    alias accept = and(control.req_valid, control.req_ready)
    alias out_of_range = or(control.req_pc[30..WORD_SIZE])
    alias invalid_pc = out_of_range
    alias bad_pc = and(accept, invalid_pc)
    alias start = and(accept, not(invalid_pc))
    alias cached = and(start, cache.hit, not(invalidate))
    alias miss = and(start, not(and(cache.hit, not(invalidate))))
    alias ar_fire = and(axi.arvalid, axi.arready)
    alias r_fire = and(axi.rvalid, axi.rready)
    alias last_fire = and(r_fire, axi.rlast)
    alias consume = and(control.res_valid, control.res_ready)
    alias response_error = or(axi.rresp[0,1], axi.rid[0..4], not(axi.rlast))
    alias finish = or(bad_pc, last_fire, cached)

    clock => {
        pc.clock, addr_wait.clock, data_wait.clock, output_full.clock,
        bus_error.clock, instruction.clock, error.clock,
    }
    reset => {
        pc.reset, addr_wait.reset, data_wait.reset, output_full.reset,
        bus_error.reset, instruction.reset, error.reset,
    }
    clock -> cache.clock
    reset -> cache.reset
    invalidate -> cache.invalidate
    control.req_pc[0..30] -> cache.lookup_address
    pc.out[0..30] -> cache.update_address
    cache.fill_en <- and(active, last_fire, not(bus_error.out), not(response_error), not(invalidate))
    cache.fill_data <- axi.rdata
    cache.store_en <- 0
    cache.store_data <- 0
    cache.store_mask <- 0
    line_source.select <- cached
    line_source.option[0] <- axi.rdata
    line_source.option[1] <- cache.line
    tetra_index.select <- cached
    tetra_index.option[0] <- [ pc.out[2..5] ]
    tetra_index.option[1] <- [ control.req_pc[2..5] ]

    control.req_ready <- and(active, ram_ready, not(or(addr_wait.out, data_wait.out, output_full.out)))
    pc.w_en <- accept
    pc.in <- control.req_pc

    // 요청을 발행한 뒤 ARREADY가 올 때까지 주소와 ARVALID 유지
    addr_wait.w_en <- 1
    addr_wait.in <- or(miss, and(addr_wait.out, not(ar_fire)))
    data_wait.w_en <- 1
    data_wait.in <- or(ar_fire, and(data_wait.out, not(last_fire)))
    output_full.w_en <- 1
    output_full.in <- or(finish, and(output_full.out, not(consume)))

    // 32바이트 정렬 주소에서 256비트 한 beat 읽음. 상위 주소는 요청 수락 시 검사.
    axi.arid <- 0
    { axi.araddr[0..5] } <= 0
    axi.araddr[5..30] <- [ pc.out[5..30] ]
    axi.arlen <- 0
    { axi.arsize[0,2] } <= 1  // 5 = 32 bytes
    axi.arsize[1] <- 0
    axi.arburst[0] <- 1  // INCR, ARLEN=0
    axi.arburst[1] <- 0
    axi.arlock <- 0
    axi.arcache <- 0
    { axi.arprot[0,1] } <= 0  // unprivileged, secure
    axi.arprot[2] <- 1       // instruction access
    axi.arqos <- 0
    axi.arvalid <- and(active, addr_wait.out)
    axi.rready <- and(active, data_wait.out)

    // AXI byte lane 0가 가장 낮은 바이트 주소.
    // MMIX big-endian 명령어: 낮은 주소의 바이트가 instruction[24..32](OP).
    tetra_mux.select <- tetra_index.selected
    tetra_mux.option[0] <- [ line_source.selected[0..32] ]
    tetra_mux.option[1] <- [ line_source.selected[32..64] ]
    tetra_mux.option[2] <- [ line_source.selected[64..96] ]
    tetra_mux.option[3] <- [ line_source.selected[96..128] ]
    tetra_mux.option[4] <- [ line_source.selected[128..160] ]
    tetra_mux.option[5] <- [ line_source.selected[160..192] ]
    tetra_mux.option[6] <- [ line_source.selected[192..224] ]
    tetra_mux.option[7] <- [ line_source.selected[224..256] ]
    instruction_mux.select <- bad_pc
    instruction_mux.option[0][24..32] <- [ tetra_mux.selected[0..8] ]
    instruction_mux.option[0][16..24] <- [ tetra_mux.selected[8..16] ]
    instruction_mux.option[0][8..16]  <- [ tetra_mux.selected[16..24] ]
    instruction_mux.option[0][0..8]   <- [ tetra_mux.selected[24..32] ]
    instruction_mux.option[1] <- 0
    instruction.w_en <- finish
    instruction.in <- instruction_mux.selected

    // 단일 beat 응답은 RLAST=1이어야 함.
    // 잘못된 다중 beat 응답도 RLAST까지 소진하고 오류로 보고.
    bus_error.w_en <- or(ar_fire, r_fire)
    bus_error.in <- and(not(ar_fire), or(bus_error.out, response_error))
    error_mux.select <- bad_pc
    error_mux.option[0] <- and(last_fire, or(bus_error.out, response_error))
    error_mux.option[1] <- 1
    error.w_en <- finish
    error.in <- error_mux.selected

    control.res_valid <- and(active, output_full.out)
    control.res_pc <- pc.out
    control.instruction <- instruction.out
    control.error <- error.out
}

// 페치 내부 저장 소자. reset은 w_en보다 우선.
seq FetchReg<N> {
    pub clock: In<bit,1>
    pub reset: In<bit,1>
    pub w_en:  In<bit,1>
    pub in:    In<bit,N>
    pub out:   Out<bit,N>

    buf: [D_FlipFlop; N]
    w_mux: Mux<2,N>
    reset_mux: Mux<2,N>
}

wire FetchReg<N> {
    clock => { buf[0..N].clock }
    w_mux.select <- w_en
    w_mux.option[0] <- [ buf[0..N].out ]
    w_mux.option[1] <- in
    reset_mux.select <- reset
    reset_mux.option[0] <- w_mux.selected
    reset_mux.option[1] <- 0
    reset_mux.selected -> [ buf[0..N].in ]
    out <- [ buf[0..N].out ]
}
